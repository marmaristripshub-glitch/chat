{% liquid
  assign mv_advanced = section.settings
  for mv_config_block in section.blocks
    if mv_config_block.type == 'mv_advanced'
      assign mv_advanced = mv_config_block.settings
      break
    endif
  endfor
%}
{% comment %}
  MarketVitrini PRO — Tek Shopify ürünü / 1-2-3 adet / gerçek sepet senkronu
  Standalone Shopify OS 2.0 product-template section.
  Real product variants, real compare-at prices, optional upsell, AJAX cart and checkout.
  Does not modify core theme product-information or other pages.
  REFERANS EKRAN METINLERI V7 (gorseldeki ornek):
  Eski fiyat: 1.499 TL | Yeni fiyat: 899 TL | %40 INDIRIM | 600 TL Kazancin var!
  Bu tutarlar Shopify'daki gercek fiyatlar ile karismamasi icin sabit yazilmaz,
  secili varyantin price ve compare_at_price alanlarindan hesaplanir.
{% endcomment %}
{% liquid
  assign mv_p = product
  if mv_p == blank
    assign mv_p = closest.product
  endif
  assign mv_v = blank
  if mv_p != blank
    assign mv_v = mv_p.selected_or_first_available_variant
  endif
  assign mv_sale = false
  if mv_v != blank and mv_v.compare_at_price > mv_v.price
    assign mv_sale = true
    assign mv_diff = mv_v.compare_at_price | minus: mv_v.price
    assign mv_pct = mv_diff | times: 100.0 | divided_by: mv_v.compare_at_price | round
  endif
  assign mv_origin = mv_v.price
  if mv_sale
    assign mv_origin = mv_v.compare_at_price
  endif
  assign mv_min = mv_v.quantity_rule.min | default: 1
  assign mv_inc = mv_v.quantity_rule.increment | default: 1
  assign mv_max = mv_v.quantity_rule.max
  assign mv_form_id = 'mvpd-form-' | append: section.id
  assign mv_gallery_manual = false
%}
<section id="mvpd-{{ section.id }}" class="mvpd" data-mvpd
  data-cart-url="{{ routes.cart_add_url }}.js"
  data-cart-redirect="{{ routes.cart_url }}"
  data-checkout-redirect="{{ routes.root_url }}checkout"
  data-root-url="{{ routes.root_url }}"
  data-next="{{ section.settings.purchase_destination }}"
  style="--ref-gallery-height:{{ section.settings.ref_gallery_height }}px;--ref-gap:{{ section.settings.ref_body_gap }}px;--mvpd-accent:{{ section.settings.accent }};--mvpd-accent-dark:{{ section.settings.accent_dark }};--mvpd-head:{{ section.settings.heading_color }};--mvpd-muted:{{ section.settings.muted_color }};--mvpd-surface:{{ section.settings.card_color }};--mvpd-soft:{{ section.settings.soft_color }};--mvpd-border:{{ section.settings.border_color }};--mvpd-width:{{ section.settings.max_width }}px;--mvpd-radius:{{ section.settings.card_radius }}px;--mvpd-price:{{ mv_advanced.price_color | default: '#BA2536' }};--mvpd-gallery-badge:{{ mv_advanced.gallery_badge_color | default: '#C92332' }};--mvpd-gallery-badge-text:{{ mv_advanced.gallery_badge_text_color | default: '#FFFFFF' }};--mvpd-feature-text:{{ mv_advanced.feature_text_color | default: '#3C4750' }};--mvpd-review-text:{{ mv_advanced.review_text_color | default: '#1F252C' }};--mvpd-social-bg:{{ mv_advanced.social_bg_color | default: '#FAEAEA' }};--mvpd-social-text:{{ mv_advanced.social_text_color | default: '#B62830' }};--mvpd-price-badge-bg:{{ mv_advanced.price_badge_color | default: '#C92331' }};--mvpd-price-badge-text:{{ mv_advanced.price_badge_text_color | default: '#FFFFFF' }};--mvpd-stock-bg:{{ section.settings.stock_panel_color }};--mvpd-stock-text:{{ mv_advanced.stock_text_color | default: '#AD202B' }};--mvpd-stock-bar-bg:{{ mv_advanced.stock_bar_track_color | default: '#ECCBD0' }};--mvpd-stock-bar:{{ mv_advanced.stock_bar_color | default: '#C32635' }};--mvpd-summary-bg:{{ mv_advanced.summary_bg_color | default: '#FFFFFF' }};--mvpd-total-bg:{{ mv_advanced.total_panel_bg | default: '#FCEDED' }};--mvpd-trust-icon:{{ mv_advanced.trust_icon_color | default: '#111111' }};--mvpd-trust-icon-bg:{{ mv_advanced.trust_icon_bg | default: '#F7F7F5' }};--mvpd-satisfaction-bg:{{ mv_advanced.satisfaction_panel_bg | default: '#FFF6DE' }};--mvpd-satisfaction-text:{{ mv_advanced.satisfaction_text_color | default: '#82501D' }};--mvpd-upsell-bg:{{ mv_advanced.upsell_panel_bg | default: '#FFFFFF' }};--mvpd-upsell-btn:{{ mv_advanced.upsell_btn_color | default: '#45943B' }};--mvpd-upsell-btn-text:{{ mv_advanced.upsell_btn_text_color | default: '#FFFFFF' }};--mvpd-upsell-badge:{{ mv_advanced.upsell_badge_color | default: '#D83D32' }};--mvpd-payment-bg:{{ mv_advanced.payment_bg_color | default: '#FFFFFF' }};">
{% if mv_p == blank %}
  <div class="mvpd__empty">Bu bölüm ürün şablonunda kullanılmalıdır. Lütfen bir ürün sayfasında önizleyin.</div>
{% else %}
  <div class="mvpd__layout">
    <div class="mvpd__left-stack">
    <div class="mvpd__main">
      <div class="mvpd__gallery" aria-label="Ürün görselleri">
        <div class="mvpd__viewer">
          {% if section.settings.show_media_slogan and section.settings.media_slogan != blank %}<span class="mvpd__media-slogan">{{ section.settings.media_slogan | escape }}</span>{% endif %}
          {% if section.settings.show_gallery_badge and section.settings.gallery_badge_text != blank %}<span class="mvpd__sale-flag" data-mvpd-flag>{{ section.settings.gallery_badge_text | escape }}</span>{% endif %}
          {% if mv_gallery_manual %}
            {% for index in (1..6) %}
              {% assign key = 'gallery_image_' | append: index %}
              {% assign gallery_image = section.settings[key] %}
              {% if gallery_image != blank %}
                <div class="mvpd__media-item{% if forloop.first %} is-active{% endif %}" data-mvpd-media="manual-{{ index }}" {% unless forloop.first %}hidden{% endunless %}>
                {{ gallery_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1500', sizes: '(max-width:749px) 90vw, 34vw', class: 'mvpd__big-image', alt: gallery_image.alt }}
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
          {% for media in mv_p.media limit: 12 %}
            <div class="mvpd__media-item{% if forloop.first %} is-active{% endif %}" data-mvpd-media="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {% case media.media_type %}
                {% when 'image' %}
                  {{ media | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1500', sizes: '(max-width:749px) 90vw, 34vw', class: 'mvpd__big-image', alt: media.alt }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, image_size: '1100x', class: 'mvpd__big-video' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag: class: 'mvpd__big-video' }}
                {% else %}
                  {% if media.preview_image != blank %}{{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'mvpd__big-image', alt: media.alt }}{% endif %}
              {% endcase %}
            </div>
          {% else %}
            <div class="mvpd__media-item is-active">{{ 'product-1' | placeholder_svg_tag: 'mvpd__big-image mvpd__placeholder' }}</div>
          {% endfor %}
          {% endif %}
        </div>
        {% if mv_gallery_manual %}
          <div class="mvpd__thumbs" role="group" aria-label="Manuel ürün görseli seçimi">
            {% for index in (1..6) %}
              {% assign key = 'gallery_image_' | append: index %}
              {% assign gallery_image = section.settings[key] %}
              {% if gallery_image != blank %}
                <button class="mvpd__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-mvpd-thumb="manual-{{ index }}" aria-label="{{ index }}. görsel" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ gallery_image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'mvpd__thumb-img', alt: gallery_image.alt }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
          <button class="mvpd__thumb-more" type="button" data-mvpd-thumb-more aria-label="Diğer ürün görselleri"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></button>
        {% elsif mv_p.media.size > 1 %}
          <div class="mvpd__thumbs" role="group" aria-label="Ürün görseli seçimi">
            {% for media in mv_p.media limit: 12 %}
              <button class="mvpd__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-mvpd-thumb="{{ media.id }}" aria-label="{{ forloop.index }}. görsel" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {% if media.preview_image != blank %}{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', class: 'mvpd__thumb-img', alt: media.alt }}{% endif %}
                {% if media.media_type != 'image' %}<span class="mvpd__play" aria-hidden="true">▶</span>{% endif %}
              </button>
            {% endfor %}
          </div>
          <button class="mvpd__thumb-more" type="button" data-mvpd-thumb-more aria-label="Diğer ürün görsellerini göster"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        {% endif %}
      </div>

      <div class="mvpd__details">
        {% if section.settings.show_vendor and section.settings.reference_vendor != blank %}
          <div class="mvpd__vendor">{{ section.settings.reference_vendor | escape }}</div>
        {% endif %}
        <h1 class="mvpd__title">{{ mv_p.title | escape }}</h1>
        {% if section.settings.show_subtitle and section.settings.subtitle != blank %}
          <p class="mvpd__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.mv_show_rating_bar or section.settings.social_proof_text != blank %}
          <div class="mvpd__review mvpd__review--reference" aria-label="Değerlendirmeler ve bilgiler">
            {% if section.settings.mv_show_rating_bar %}
              <span class="mvpd__review-stars" aria-hidden="true">{{ section.settings.manual_stars | escape }}</span>
              <strong class="mvpd__rating-value">{{ section.settings.verified_rating | default: '4.8' | escape }}</strong>
              <small class="mvpd__rating-count">({{ section.settings.verified_reviews_count | default: '2.341' | escape }} {{ section.settings.review_count_label | escape }})</small>
            {% endif %}
            {% if section.settings.social_proof_text != blank %}
              <span class="mvpd__social-proof"><span class="mvpd__social-symbol" aria-hidden="true">{{ section.settings.social_proof_icon | escape }}</span> {{ section.settings.social_proof_text | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
        <div class="mvref-intro">
          <h2>{{ section.settings.ref_headline | escape }}</h2>
          <p>{{ section.settings.ref_intro | escape }}</p>
        </div>
        <div class="mvref-benefits">
          {% for i in (1..6) %}{% assign ik = 'ref_benefit_icon_' | append: i %}{% assign tk = 'ref_benefit_title_' | append: i %}{% assign dk = 'ref_benefit_detail_' | append: i %}
          {% if section.settings[tk] != blank %}<div class="mvref-benefit"><span>{{ section.settings[ik] | escape }}</span><div><b>{{ section.settings[tk] | escape }}</b><small>{{ section.settings[dk] | escape }}</small></div></div>{% endif %}{% endfor %}
        </div>
        <div class="mvref-why"><strong>✿ {{ section.settings.ref_why_title | escape }}</strong><div class="mvref-why-grid">
        {% for i in (1..6) %}{% assign tk = 'ref_why_' | append: i %}<span><i>✓</i>{{ section.settings[tk] | escape }}</span>{% endfor %}
        </div></div>
        {% if section.settings.show_features %}
          <ul class="mvpd__features mvpd__features--reference" aria-label="Öne çıkan özellikler">
            {% for n in (1..6) %}
              {% assign feature_key = 'feature_' | append: n %}
              {% assign feature_text = section.settings[feature_key] %}
              {% if feature_text != blank %}
                <li><span class="mvpd__feature-check" aria-hidden="true">{{ section.settings.feature_icon | escape }}</span><span>{{ feature_text | escape }}</span></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
        {% form 'product', mv_p, id: mv_form_id, class: 'mvpd__form' %}
          {% unless mv_p.has_only_default_variant %}
            <label class="mvpd__field-label" for="mvpd-variant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label>
            <select class="mvpd__variant" id="mvpd-variant-{{ section.id }}" data-mvpd-variant>
              {% for variant in mv_p.variants %}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}" data-inventory="{{ variant.inventory_quantity }}" data-inventory-management="{{ variant.inventory_management }}" data-inventory-policy="{{ variant.inventory_policy }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-inc="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" {% if variant.id == mv_v.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title | escape }}{% unless variant.available %}  — {{ section.settings.variant_sold_out_label | escape }}{% endunless %}
                </option>
              {% endfor %}
            </select>
          {% endunless %}
          <input type="hidden" name="id" value="{{ mv_v.id }}" data-mvpd-id>
          <div class="mvpd__purchase-row">
            <div class="mvpd__quantity-area">
              <label class="mvpd__field-label" for="mvpd-qty-{{ section.id }}">{{ section.settings.quantity_label | escape }}</label>
              <div class="mvpd__qty">
                <button type="button" data-mvpd-minus aria-label="Adet azalt">−</button>
                <input id="mvpd-qty-{{ section.id }}" type="number" name="quantity" value="{{ mv_min }}" min="{{ mv_min }}" step="{{ mv_inc }}" {% if mv_max != blank %}max="{{ mv_max }}"{% endif %} data-mvpd-qty aria-label="Ürün adedi">
                <button type="button" data-mvpd-plus aria-label="Adet artır">+</button>
              </div>
            </div>
            <div class="mvpd__price-area">
              {% if mv_sale and section.settings.show_compare_price %}<s data-mvpd-old>{{ mv_v.compare_at_price | money_without_trailing_zeros }}</s>{% else %}<s data-mvpd-old hidden></s>{% endif %}
              <div class="mvpd__price-line">
                <strong data-mvpd-unit>{{ mv_v.price | money_without_trailing_zeros }}</strong>
                {% if section.settings.show_price_badge and section.settings.price_badge_text != blank %}<span class="mvpd__pct" data-mvpd-pct>{{ section.settings.price_badge_text | escape }}</span>{% endif %}
                {% if section.settings.show_savings_box %}<span class="mvpd__save" data-mvpd-save><b data-mvpd-save-amount>{% if section.settings.savings_value != blank %}{{ section.settings.savings_value | escape }}{% elsif mv_sale %}{{ mv_diff | money_without_trailing_zeros }}{% endif %}</b><small>{{ section.settings.savings_label | escape }}</small></span>{% endif %}
              </div>
            </div>
          </div>
          <div class="mvpd__inventory-wrap" data-mvpd-stock-panel data-low-stock="true">
            <div class="mvpd__stock-head">
              <div class="mvpd__stock-copy">
                {% if section.settings.stock_icon != blank %}<span class="mvpd__stock-flame" aria-hidden="true">{{ section.settings.stock_icon | escape }}</span>{% endif %}
                <strong class="mvpd__inventory">{{ section.settings.reference_stock_text | escape }}</strong>
                <span class="mvpd__visitor-inline">{{ section.settings.inventory_info | escape }}</span>
              </div>
            </div>
            {% if section.settings.show_stock_progress %}<div class="mvpd__stock-track" aria-hidden="true"><span class="mvpd__stock-fill" style="width:{{ section.settings.manual_stock_progress }}%"></span></div>{% endif %}
          </div>
        {% endform %}
      </div>
    </div>


    <div class="mvpd__bundle-in-slot" data-mvpd-bundle-in-slot>
      <section class="mv-onepack" aria-label="Aynı üründen 1, 2 veya 3 adet seçin">
        <div class="mvref-pack-header"><div class="mvref-pack-header__left"><span class="mvref-pack-header__icon" aria-hidden="true">◆</span><b>{{ section.settings.ref_pack_title | escape }}</b></div><small>{{ section.settings.ref_pack_note | escape }}</small></div>
        <div class="mv-onepack__grid">
          {% for pack_number in (1..3) %}
            {% liquid
              assign pack_block = blank
              for block in section.blocks
                if block.type == 'bundle' and block.settings.qty == pack_number
                  assign pack_block = block
                  break
                endif
              endfor
              assign pack_image = mv_p.featured_image
              if pack_block != blank and pack_block.settings.image != blank
                assign pack_image = pack_block.settings.image
              endif
              assign pack_accent = '#548E79'
              assign pack_soft = '#F3FBF4'
              if pack_number == 2
                assign pack_accent = '#7E5AD3'
                assign pack_soft = '#F5F0FF'
              elsif pack_number == 3
                assign pack_accent = '#CC8C39'
                assign pack_soft = '#FFF9EA'
              endif
              if pack_block != blank
                assign pack_accent = pack_block.settings.accent | default: pack_accent
                assign pack_soft = pack_block.settings.soft | default: pack_soft
              endif
              assign pack_total = mv_v.price | times: pack_number
            %}
            <article class="mv-onepack__card{% if pack_number == 2 %} mv-onepack__card--featured{% endif %}" data-mv-pack data-qty="{{ pack_number }}" style="--pack-accent:{{ pack_accent }};--pack-soft:{{ pack_soft }}">
              {% liquid
                assign pack_discount_pct = 0
                if pack_number == 2
                  assign pack_discount_pct = section.settings.mv_pack_discount_2
                elsif pack_number == 3
                  assign pack_discount_pct = section.settings.mv_pack_discount_3
                endif
                assign pack_preview_total = pack_total
                if pack_discount_pct > 0
                  assign pack_saving_cents = pack_total | times: pack_discount_pct | divided_by: 100
                  assign pack_preview_total = pack_total | minus: pack_saving_cents
                endif
              %}
              {% if pack_number == 2 %}<div class="mv-onepack__ribbon">{% if pack_block != blank and pack_block.settings.top_badge != blank %}{{ pack_block.settings.top_badge | escape }}{% else %}{{ section.settings.mv_b16_featured_badge_fallback | escape }}{% endif %}</div>{% endif %}
              <div class="mv-onepack__main">
                <div class="mv-onepack__visual mv-onepack__visual--{{ pack_number }}" aria-hidden="true">
                  {% if pack_image != blank %}
                    {% for image_copy in (1..pack_number) %}
                      {{ pack_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'mv-onepack__img' }}
                    {% endfor %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'mv-onepack__img mv-onepack__img--placeholder' }}
                  {% endif %}
                </div>
                <div class="mv-onepack__content">
                  <div class="mv-onepack__content-top">
                    <div class="mvref-pack-copy">
                      <b>{% if pack_block != blank and pack_block.settings.custom_title != blank %}{{ pack_block.settings.custom_title | escape }}{% else %}{{ pack_number }} {{ section.settings.ref_pack_unit | escape }}{% endif %}</b>
                      <small>{% if pack_block != blank and pack_block.settings.custom_subtitle != blank %}{{ pack_block.settings.custom_subtitle | escape }}{% else %}{{ pack_number | times: 10 }} günlük kullanım{% endif %}</small>
                    </div>
                    {% if pack_discount_pct > 0 %}
                      <div class="mv-onepack__discount-badge" data-mv-pack-discount>%{{ pack_discount_pct }}<span>{{ section.settings.pack_discount_word | escape }}</span></div>
                    {% endif %}
                  </div>
                  <div class="mv-onepack__pricing">
                    {% if pack_discount_pct > 0 %}<s class="mv-onepack__compare" data-mv-pack-compare>{{ pack_total | money_without_trailing_zeros }}</s>{% endif %}
                    <strong class="mv-onepack__price" data-mv-pack-price>{{ pack_preview_total | money_without_trailing_zeros }}</strong>
                    <small class="mv-onepack__real-saving" data-mv-pack-saving hidden></small>
                  </div>
                  <button class="mv-onepack__button" type="button" data-mv-pack-select {% unless mv_v.available %}disabled{% endunless %}>{{ section.settings.pack_select_label | escape }}</button>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
        {% if request.design_mode %}
          <p class="mv-onepack__admin-note">Bilgi: Bu kartlardaki tutarlar %{{ section.settings.mv_pack_discount_2 }} / %{{ section.settings.mv_pack_discount_3 }} hedef indirim önizlemesidir. Gerçek indirim, Shopify İndirimler üzerinden ayrıca tanımlanmalı ve ödeme testinde doğrulanmalıdır. Otomatik indirimler yalnızca Shopify kurallarına göre uygulanır.</p>
        {% endif %}
      </section>
    </div>
    <div class="mvref-reviews"><div class="mvref-reviews-head"><b>☆ {{ section.settings.ref_reviews_title | escape }}</b></div>
      <div class="mvref-review-grid">{% assign mv_rendered_reviews = 0 %}{% for block in section.blocks %}{% if block.type == 'ref_review' and mv_rendered_reviews < 3 %}{% assign mv_rendered_reviews = mv_rendered_reviews | plus: 1 %}<article class="mvref-review" {{ block.shopify_attributes }}>
      {% if block.settings.photo != blank %}{{ block.settings.photo | image_url: width: 140 | image_tag: loading: 'lazy', class: 'mvref-review-image' }}{% else %}<div class="mvref-review-image mvref-review-placeholder">★</div>{% endif %}
      <div><span class="mvref-stars">★★★★★</span> <small>{{ block.settings.rating | escape }}/5</small><p>“{{ block.settings.body | escape }}”</p><small>{{ block.settings.author | escape }} · {{ block.settings.date | escape }}</small></div></article>{% endif %}{% endfor %}
      {% for block in section.blocks %}{% if block.type == 'mv_four_reviews' %}
        {% for n in (1..3) %}
          {% assign body_key = 'body_' | append: n %}
          {% assign author_key = 'author_' | append: n %}
          {% assign date_key = 'date_' | append: n %}
          {% assign rating_key = 'rating_' | append: n %}
          {% assign photo_key = 'photo_' | append: n %}
          {% if block.settings[body_key] != blank and mv_rendered_reviews < 3 %}{% assign mv_rendered_reviews = mv_rendered_reviews | plus: 1 %}
          <article class="mvref-review" {{ block.shopify_attributes }}>
            {% if block.settings[photo_key] != blank %}{{ block.settings[photo_key] | image_url: width: 160 | image_tag: loading: 'lazy', class: 'mvref-review-image' }}{% else %}<div class="mvref-review-image mvref-review-placeholder">★</div>{% endif %}
            <div><span class="mvref-stars" aria-label="5 üzerinden {{ block.settings[rating_key] | escape }} puan">{% assign stars_number = block.settings[rating_key] | plus: 0 %}{% for st in (1..5) %}{% if st <= stars_number %}★{% else %}☆{% endif %}{% endfor %}</span> <small>{{ block.settings[rating_key] | escape }}/5</small>
              <p>“{{ block.settings[body_key] | escape }}”</p><small>{{ block.settings[author_key] | escape }}{% if block.settings[date_key] != blank %} · {{ block.settings[date_key] | escape }}{% endif %}</small>
            </div>
          </article>
          {% endif %}
        {% endfor %}
      {% endif %}{% endfor %}
      {% if mv_rendered_reviews == 0 and request.design_mode %}<div class="mvref-reviews-empty">Yorum görünmesi için bu bölüme “Manuel Müşteri Yorumu” veya “4 Manuel Müşteri Yorumu” bloğu ekleyip gerçek yorumları girin. Ana sayfadaki başka bir bölümün blokları Shopify Liquid ile doğrudan okunamaz.</div>{% endif %}
      </div>
    </div>

      {% comment %} Editable usage guide — defaults also appear on existing product templates. {% endcomment %}
      {% liquid
        assign mvu_block = nil
        for block in section.blocks
          if block.type == 'mv_usage_guide'
            assign mvu_block = block
            break
          endif
        endfor
        assign mvu_show = true
        if mvu_block
          assign mvu_show = mvu_block.settings.enabled
        endif
        assign mvu_image = mvu_block.settings.image | default: mv_p.featured_image
        assign mvu_show_image = true
        if mvu_block
          assign mvu_show_image = mvu_block.settings.show_image
        endif
        assign mvu_heading = 'Üç adımda günlük rutininize ekleyin'
        assign mvu_eyebrow = 'KULLANIM REHBERİ'
        assign mvu_note = 'Porsiyon ve kullanım sıklığı için ürün etiketini esas alın.'
        if mvu_block
          assign mvu_heading = mvu_block.settings.heading
          assign mvu_eyebrow = mvu_block.settings.eyebrow
          assign mvu_note = mvu_block.settings.note
        endif
      %}
      {% if mvu_show %}
        <section class="mvu-guide" {% if mvu_heading != blank %}aria-labelledby="mvu-heading-{{ section.id }}"{% else %}aria-label="Kullanım rehberi"{% endif %}
          {{ mvu_block.shopify_attributes }}
          style="--mvu-bg:{{ mvu_block.settings.background | default: '#eff6ff' }};--mvu-border:{{ mvu_block.settings.border_color | default: '#dce8f8' }};--mvu-title:{{ mvu_block.settings.heading_color | default: '#10244c' }};--mvu-text:{{ mvu_block.settings.text_color | default: '#53627c' }};--mvu-accent:{{ mvu_block.settings.accent_color | default: '#0965e8' }};--mvu-radius:{{ mvu_block.settings.radius | default: 16 }}px;">
          <div class="mvu-inner{% unless mvu_show_image %} mvu-inner--no-image{% endunless %}">
            {% if mvu_show_image %}
              <div class="mvu-media" style="--mvu-image-fit:{{ mvu_block.settings.image_fit | default: 'contain' }};">
                {% if mvu_image != blank %}
                  {{ mvu_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 400, 700', sizes: '(min-width: 1200px) 240px, (min-width: 600px) 200px, 100vw', class: 'mvu-photo' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'mvu-placeholder' }}
                {% endif %}
              </div>
            {% endif %}
            <div class="mvu-content">
              {% if mvu_eyebrow != blank %}<p class="mvu-eyebrow">{{ mvu_eyebrow | escape }}</p>{% endif %}
              {% if mvu_heading != blank %}<h2 class="mvu-heading" id="mvu-heading-{{ section.id }}">{{ mvu_heading | escape }}</h2>{% endif %}
              <ol class="mvu-steps" role="list">
                {% for step in (1..3) %}
                  {% liquid
                    assign key = 'step_' | append: step | append: '_'
                    assign title_key = key | append: 'title'
                    assign text_key = key | append: 'text'
                    assign icon_key = key | append: 'icon'
                    assign image_key = key | append: 'image'
                    assign symbol_key = key | append: 'symbol'
                    assign color_key = key | append: 'color'
                    assign background_key = key | append: 'background'
                    case step
                      when 1
                        assign step_title = 'Ölçün'
                        assign step_text = 'Ürün etiketindeki porsiyonu hazırlayın.'
                        assign step_icon = 'scoop'
                      when 2
                        assign step_title = 'Karıştırın'
                        assign step_text = 'Talimatlara uygun bir içeceğe ekleyin.'
                        assign step_icon = 'glass'
                      when 3
                        assign step_title = 'Tüketin'
                        assign step_text = 'Önerilen kullanım şeklini takip edin.'
                        assign step_icon = 'check'
                    endcase
                    if mvu_block
                      assign step_title = mvu_block.settings[title_key]
                      assign step_text = mvu_block.settings[text_key]
                      assign step_icon = mvu_block.settings[icon_key]
                    endif
                  %}
                  <li class="mvu-step" style="--mvu-icon:{{ mvu_block.settings[color_key] | default: '#0965e8' }};--mvu-icon-bg:{{ mvu_block.settings[background_key] | default: '#ffffff' }};">
                    <span class="mvu-icon" aria-hidden="true">
                      {% if mvu_block.settings[image_key] != blank %}
                        {{ mvu_block.settings[image_key] | image_url: width: 120 | image_tag: loading: 'lazy', width: 32, height: 32, alt: '' }}
                      {% elsif step_icon == 'symbol' %}
                        <span class="mvu-symbol">{{ mvu_block.settings[symbol_key] | escape }}</span>
                      {% else %}
                        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                          {% case step_icon %}
                            {% when 'scoop' %}<path d="m4 22 11-11 5 5L9 27a3.5 3.5 0 0 1-5-5Z"/><path d="m14 12 3-3a6 6 0 0 1 9 8l-3 3-9-8Z"/><path d="m18 10 7 7"/>
                            {% when 'glass' %}<path d="m8 7 2 22h12l2-22H8Z"/><path d="M10 15h13M18 7l4-5M13 20l2 2m4-3 1 2"/>
                            {% when 'calendar' %}<rect x="5" y="7" width="22" height="22" rx="4"/><path d="M10 3v8m12-8v8M5 14h22m-15 7 3 3 6-6"/>
                            {% when 'leaf' %}<path d="M26 5C10 2 2 14 9 23c9 7 20-2 17-18Z"/><path d="M6 28 22 11m-8 8v-7m0 7h7"/>
                            {% when 'drop' %}<path d="M16 3S6 14 6 20a10 10 0 0 0 20 0C26 14 16 3 16 3Z"/><path d="M11 21a5 5 0 0 0 5 5"/>
                            {% when 'clock' %}<circle cx="16" cy="16" r="12"/><path d="M16 8v8l6 4"/>
                            {% when 'heart' %}<path d="M16 28 5 17C-3 8 10-2 16 9 22-2 35 8 27 17L16 28Z"/>
                            {% else %}<circle cx="16" cy="16" r="12"/><path d="m10 16 4 4 8-9"/>
                          {% endcase %}
                        </svg>
                      {% endif %}
                      <span class="mvu-number">0{{ step }}</span>
                    </span>
                    <div class="mvu-step-copy">
                      {% if step_title != blank %}<h3 class="mvu-step-title">{{ step_title | escape }}</h3>{% endif %}
                      {% if step_text != blank %}<p class="mvu-step-text">{{ step_text | escape | newline_to_br }}</p>{% endif %}
                    </div>
                  </li>
                {% endfor %}
              </ol>
              {% if mvu_note != blank %}<p class="mvu-note">{{ mvu_note | escape }}</p>{% endif %}
            </div>
          </div>
        </section>
      {% endif %}

    </div><!-- /.mvpd__left-stack -->
    <aside class="mvpd__summary" aria-label="Sipariş özeti">
      <div class="mvref-timer" data-ref-clock data-minutes="{{ section.settings.ref_timer_minutes }}">
        <div class="mvref-flame">♨</div><div class="mvref-timer-copy"><b>{{ section.settings.ref_campaign_title | escape }}</b><small>{{ section.settings.ref_campaign_desc | escape }}</small></div>
        <div class="mvref-clock"><b data-ref-hh>09</b><small>Saat</small></div><div class="mvref-clock"><b data-ref-mm>42</b><small>Dakika</small></div><div class="mvref-clock"><b data-ref-ss>17</b><small>Saniye</small></div>
      </div>
      <div class="mvref-buy mvref-orderbox">
        <div class="mvref-order-head">
          <div class="mvref-order-heading"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.3"/><circle cx="19" cy="20" r="1.3"/><path d="M2 3h2l2.5 12H20l2-9H5"/></svg><b>Sipariş Özeti</b></div>
          <span class="mvref-order-secure">◆ Güvenli Alışveriş</span>
        </div>
        <div class="mvref-order-product">
          {% if mv_p.featured_image != blank %}{{ mv_p.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'mvref-order-photo', alt: mv_p.title }}{% endif %}
          <div class="mvref-order-product-info"><strong>{{ mv_p.title | escape }}</strong><small>{{ mv_p.type | escape }}</small></div>
          <div class="mvref-order-product-total"><small><span data-ref-order-qty>{{ mv_min }}</span> adet</small><b data-ref-order-line>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</b></div>
        </div>
        <div class="mvref-order-rows">
          <div><span>Ara Toplam</span><strong data-ref-order-subtotal>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</strong></div>
          <div class="mvref-order-discount"><span>İndirim</span><strong data-ref-order-discount>₺0</strong></div>
          <div><span>Kargo</span><strong class="mvref-order-shipping">{{ section.settings.shipping_note | escape }}</strong></div>
        </div>
        <div class="mvref-order-total"><strong>Toplam Tutar</strong><b data-ref-price>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</b></div>
        <div class="mvref-order-coupon"><label for="mvref-discount-{{ section.id }}">✂ İndirim Kodu</label><div><input id="mvref-discount-{{ section.id }}" type="text" data-ref-order-coupon placeholder="Kupon kodunuz" autocomplete="off"><button type="button" data-ref-order-coupon-apply>Uygula</button></div></div>
        <div class="mvref-order-comparison"><s data-ref-compare{% unless mv_sale %} hidden{% endunless %}>{% if mv_sale %}{{ mv_v.compare_at_price | money_without_trailing_zeros }}{% endif %}</s><b data-ref-discount{% unless mv_sale %} hidden{% endunless %}>{% if mv_sale %}%{{ mv_pct }}<small>{{ section.settings.pack_discount_word | escape }}</small>{% endif %}</b></div>
        <div class="mvref-stock" aria-label="Stok ve ilgi bilgisi"><span class="mvref-stock-primary">● {{ section.settings.reference_stock_text | escape }}</span>{% if section.settings.inventory_info != blank %}<span class="mvref-stock-visitor">{{ section.settings.inventory_info | escape }}</span>{% endif %}</div><div class="mvref-stock-track"><span style="width:{{ section.settings.manual_stock_progress }}%"></span></div>
        <div class="mvref-cartcontrols"><b>{{ section.settings.quantity_label | escape }}</b><div class="mvref-qty-buttons"><button type="button" data-ref-minus>−</button><span data-ref-qty>{{ mv_min }}</span><button type="button" data-ref-plus>+</button></div><span class="mvref-instock">Stokta ✓</span></div>
        <button type="button" class="mvref-add" data-ref-add>🛒 &nbsp;{{ section.settings.ref_add_text | escape }} &nbsp; →</button>
        <button type="button" class="mvref-now" data-ref-now>ϟ &nbsp; {{ section.settings.ref_now_text | escape }}</button>
      </div>
      <div class="mvref-trust-six">{% for i in (1..3) %}{% assign ik = 'ref_trust_icon_' | append: i %}{% assign tk = 'ref_trust_' | append: i %}{% assign dk = 'ref_trust_detail_' | append: i %}
      <div><span>{{ section.settings[ik] | escape }}</span><p><b>{{ section.settings[tk] | escape }}</b><small>{{ section.settings[dk] | escape }}</small></p></div>{% endfor %}</div>

      <h2 class="mvpd__summary-title"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h2l2 11h13l2-8H5"/></svg>{{ section.settings.summary_heading | escape }}</h2>
      <div class="mvpd__live-cart-list" data-mvpd-live-cart-list hidden aria-live="polite"></div>
      <p class="mvpd__cart-check" data-mvpd-cart-check>Shopify sepeti kontrol ediliyor...</p>
      <div class="mvpd__summary-item" data-mvpd-base-summary>
        {% if mv_p.featured_image != blank %}{{ mv_p.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', class: 'mvpd__summary-photo', alt: mv_p.title }}{% endif %}
        <div class="mvpd__summary-product"><strong>{{ mv_p.title | escape }}</strong><small data-mvpd-selected-title>{% unless mv_p.has_only_default_variant %}{{ mv_v.title | escape }}{% endunless %}</small><button type="button" class="mvpd__bundle-remove" data-mvpd-base-remove aria-label="Tekli ürünü sipariş özetinden kaldır">Tek ürünü kaldır</button></div>
        <div class="mvpd__summary-item-price"><span data-mvpd-count>{{ mv_min }} {{ section.settings.quantity_unit | escape }}</span><strong data-mvpd-sum-unit>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</strong><s data-mvpd-summary-old {% unless mv_sale and section.settings.show_compare_price %}hidden{% endunless %}>{% if mv_sale %}{{ mv_v.compare_at_price | times: mv_min | money_without_trailing_zeros }}{% endif %}</s></div>
      </div>
      <div class="mvpd__summary-item mvpd__summary-selected-bundle" data-mvpd-bundle-summary hidden aria-live="polite">
        <img class="mvpd__summary-photo" data-mvpd-bundle-photo alt="" width="52" height="52" hidden>
        <div class="mvpd__summary-product">
          <strong data-mvpd-bundle-name></strong>
          <small data-mvpd-bundle-detail></small>
          <button type="button" class="mvpd__bundle-remove" data-mvpd-bundle-remove aria-label="Paketi sipariş özetinden çıkar">Paketi kaldır</button>
        </div>
        <div class="mvpd__summary-item-price">
          <span data-mvpd-bundle-count></span>
          <strong data-mvpd-bundle-price></strong>
          <s data-mvpd-bundle-old hidden></s>
        </div>
      </div>
      <div class="mvpd__summary-empty" data-mvpd-summary-empty hidden aria-live="polite">
        <span>Sipariş özetiniz boş. Bir paket seçebilir veya tek ürünü yeniden ekleyebilirsiniz.</span>
        <button type="button" class="mvpd__summary-restore" data-mvpd-base-restore>Tek ürünü yeniden ekle</button>
      </div>
      <div class="mvpd__sums">
        <div><span>{{ section.settings.subtotal_label | escape }}</span><span data-mvpd-subtotal>{{ mv_origin | times: mv_min | money_without_trailing_zeros }}</span></div>
        <div class="mvpd__discount-row" data-mvpd-discount-row><span>{{ section.settings.discount_row_label | escape }}</span><span data-mvpd-discount>{% if mv_sale %}-{{ mv_diff | times: mv_min | money_without_trailing_zeros }}{% else %}0{% endif %}</span></div>
        <div class="mvpd__shipping-row"><span>{{ section.settings.shipping_label | escape }}</span><span data-mvpd-shipping>{{ section.settings.shipping_note | default: '0' | escape }}</span></div>
      </div>
      <div class="mvpd__total-box">
        <span>{{ section.settings.total_label | escape }}</span>
        <div class="mvpd__total-value">
          <strong data-mvpd-total>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</strong>
          {% if section.settings.mv_show_total_savings %}
            <small class="mvpd__total-savings-badge" data-mvpd-savings>
              <span class="mvpd__savings-symbol" aria-hidden="true">{{ section.settings.mv_total_savings_icon | escape }}</span>
              <span data-mvpd-savings-amount>
                {% if section.settings.mv_manual_total_savings != blank %}
                  {{ section.settings.mv_manual_total_savings | escape }}
                {% elsif mv_sale %}
                  {{ mv_diff | times: mv_min | money_without_trailing_zeros }}
                {% else %}
                  {{ section.settings.mv_total_fallback_text | escape }}
                {% endif %}
              </span>
              <span data-mvpd-savings-label>{% if section.settings.mv_manual_total_savings != blank or mv_sale %}{{ section.settings.savings_label | escape }}{% endif %}</span>
            </small>
          {% endif %}
        </div>
      </div>
      {% if section.settings.show_coupon %}
        <div class="mvpd__coupon"><label for="mvpd-coupon-{{ section.id }}">{{ section.settings.coupon_label | escape }}</label><div class="mvpd__coupon-fields"><input id="mvpd-coupon-{{ section.id }}" type="text" placeholder="{{ section.settings.coupon_placeholder | escape }}" data-mvpd-coupon autocomplete="off"><button type="button" data-mvpd-coupon-apply>{{ section.settings.coupon_button_label | escape }}</button></div><p class="mvpd__coupon-info" data-mvpd-coupon-info hidden>{{ section.settings.coupon_info | escape }}</p></div>
      {% endif %}
      <button type="button" class="mvpd__checkout" data-mvpd-checkout {% unless mv_v.available %}disabled{% endunless %}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span data-mvpd-checkout-label>{{ section.settings.checkout_label | escape }}</span><span aria-hidden="true">→</span>
      </button>
      <div class="mvpd__delivery-steps" aria-label="Sipariş teslimat süreci">
        <div class="mvpd__delivery-line" aria-hidden="true"></div>
        <div class="mvpd__delivery-step is-active">
          <span class="mvpd__delivery-icon">✓</span>
          <strong>{{ section.settings.delivery_step_1_title | escape }}</strong>
          <small>{{ section.settings.delivery_step_1_date | escape }}</small>
        </div>
        <div class="mvpd__delivery-step">
          <span class="mvpd__delivery-icon">🚚</span>
          <strong>{{ section.settings.delivery_step_2_title | escape }}</strong>
          <small>{{ section.settings.delivery_step_2_date | escape }}</small>
        </div>
        <div class="mvpd__delivery-step">
          <span class="mvpd__delivery-icon">📦</span>
          <strong>{{ section.settings.delivery_step_3_title | escape }}</strong>
          <small>{{ section.settings.delivery_step_3_date | escape }}</small>
        </div>
        <div class="mvpd__delivery-step">
          <span class="mvpd__delivery-icon">▣</span>
          <strong>{{ section.settings.delivery_step_4_title | escape }}</strong>
          <small>{{ section.settings.delivery_step_4_date | escape }}</small>
        </div>
      </div>
      <div class="mvpd__error" data-mvpd-error role="alert" hidden></div>
      {% if section.settings.mv_show_installments %}
        <div class="mvpd__installments" aria-label="Taksit seçenekleri">
          {% if section.settings.mv_installments_title != blank %}<h3 class="mvpd__installments-title">{{ section.settings.mv_installments_title | escape }}</h3>{% endif %}
          {% if section.settings.mv_installments_subtitle != blank %}<p class="mvpd__installments-subtitle">{{ section.settings.mv_installments_subtitle | escape }}</p>{% endif %}
          <div class="mvpd__installment-logos">
            {% for index in (1..8) %}
              {% assign installment_image_key = 'mv_installment_image_' | append: index %}
              {% assign installment_image = section.settings[installment_image_key] %}
              {% if installment_image != blank %}
                <span class="mvpd__installment-logo">{{ installment_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: installment_image.alt }}</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% if section.settings.show_trust %}
        <div class="mvpd__trusts">
          {% if section.settings.show_trust_1 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 10H4V5"/><path d="M4.5 10a8 8 0 1 1 2.2 7"/><path d="M9 13h6"/></svg>{% else %}{{ section.settings.trust_icon_1 | escape }}{% endif %}</span><strong>{{ section.settings.trust_1 | escape }}</strong><small>{{ section.settings.trust_note_1 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_2 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3 8 8 11 5-3 8-6 8-11V5l-8-3Z"/><path d="m8 12 3 3 5-6"/></svg>{% else %}{{ section.settings.trust_icon_2 | escape }}{% endif %}</span><strong>{{ section.settings.trust_2 | escape }}</strong><small>{{ section.settings.trust_note_2 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_3 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v11H3zM14 11h4l3 4v3h-7"/><circle cx="7.5" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>{% else %}{{ section.settings.trust_icon_3 | escape }}{% endif %}</span><strong>{{ section.settings.trust_3 | escape }}</strong><small>{{ section.settings.trust_note_3 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_4 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h5"/></svg>{% else %}{{ section.settings.trust_icon_4 | escape }}{% endif %}</span><strong>{{ section.settings.trust_4 | escape }}</strong><small>{{ section.settings.trust_note_4 | escape }}</small></div>{% endif %}
        </div>
      {% endif %}
      {% if section.settings.show_satisfaction %}
        {% liquid
          assign manual_secure_logo_count = 0
          for secure_logo_index in (1..5)
            assign secure_logo_key = 'secure_logo_' | append: secure_logo_index
            if section.settings[secure_logo_key] != blank
              assign manual_secure_logo_count = manual_secure_logo_count | plus: 1
            endif
          endfor
        %}
        <div class="mvpd__summary-note mvpd__safe-shop" aria-label="Güvenle alışveriş bilgileri">
          <div class="mvpd__safe-shop-head">
            <span class="mvpd__safe-shop-shield" aria-hidden="true">
              <svg viewBox="0 0 48 52" fill="none"><path d="M24 2 43 9v14c0 13-8 21-19 27C13 44 5 36 5 23V9L24 2Z" fill="#fff"/><path d="M24 8 37 13v10c0 9-5.5 15.5-13 20-7.5-4.5-13-11-13-20V13L24 8Z" fill="#FDF8EB"/><path d="m17 25 5 5 10-12" stroke="#A8760C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="mvpd__safe-shop-copy">
              <strong>{{ section.settings.secure_box_title | default: 'Güvenle Alışveriş Yapın' | escape }}</strong>
              {% if section.settings.secure_box_text != blank %}{% assign mv_secure_text_html = section.settings.secure_box_text | escape | replace: '256 bit SSL', '<strong>256 bit SSL</strong>' %}<p>{{ mv_secure_text_html }}</p>{% endif %}
            </div>
          </div>
          {% if section.settings.ref_show_secure_payments %}
            <div class="mvpd__safe-shop-payments" aria-label="Mağazada kullanılabilen ödeme yöntemleri">
              {% if manual_secure_logo_count > 0 %}
                {% for secure_logo_index in (1..5) %}
                  {% assign secure_logo_key = 'secure_logo_' | append: secure_logo_index %}
                  {% assign secure_logo = section.settings[secure_logo_key] %}
                  {% if secure_logo != blank %}
                    <span class="mvpd__safe-shop-payment">{{ secure_logo | image_url: width: 160 | image_tag: loading: 'lazy', class: 'mvpd__safe-shop-pay-logo', alt: secure_logo.alt | escape }}</span>
                  {% endif %}
                {% endfor %}
              {% elsif shop.enabled_payment_types.size > 0 %}
                {% for payment_type in shop.enabled_payment_types limit: 8 %}
