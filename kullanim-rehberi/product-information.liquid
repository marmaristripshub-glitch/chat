{% schema %}
{
  "name": "MV Tek Urun 1-2-3 PRO",
  "tag": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "bundle",
      "name": "Paket Kartı",
      "limit": 3,
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Kartı göster",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Öne çıkan kart",
          "default": false
        },
        {
          "type": "range",
          "id": "qty",
          "label": "Paket adedi",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1
        },
        {
          "type": "header",
          "content": "Manuel Fiyatlar"
        },
        {
          "type": "header",
          "content": "İndirim Balonu"
        },
        {
          "type": "checkbox",
          "id": "show_discount_badge",
          "label": "İndirim balonunu göster",
          "default": true
        },
        {
          "type": "text",
          "id": "discount_top",
          "label": "Balon üst yazısı",
          "default": "ÖZEL"
        },
        {
          "type": "text",
          "id": "discount_text",
          "label": "Balon alt yazısı",
          "default": "İNDİRİM"
        },
        {
          "type": "header",
          "content": "Kart Görseli"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Karta özel ürün görseli"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobil paket görseli (isteğe bağlı)"
        },
        {
          "type": "select",
          "id": "image_mode",
          "label": "Görsel yerleşimi",
          "options": [
            {
              "value": "cover",
              "label": "Kutuyu tamamen doldur"
            },
            {
              "value": "contain",
              "label": "Görseli tamamen göster"
