<script>
(()=>{
  const root=document.getElementById('mvpd-{{ section.id }}');if(!root)return;
  const timer=root.querySelector('[data-ref-clock]');
  if(!timer)return;
  const key='mvref-clock-{{ section.id }}',duration=Number(timer.dataset.minutes||580)*60000;
  let end=Number(sessionStorage.getItem(key));
  if(!end||end<Date.now()){end=Date.now()+duration;sessionStorage.setItem(key,String(end));}
  const tick=()=>{
    const left=Math.max(0,Math.floor((end-Date.now())/1000));
    for(const [selector,value] of [['[data-ref-hh]',Math.floor(left/3600)],['[data-ref-mm]',Math.floor(left%3600/60)],['[data-ref-ss]',left%60]]){
      const el=timer.querySelector(selector);if(el)el.textContent=String(value).padStart(2,'0');
    }
  };
  tick();const interval=setInterval(tick,1000);
  document.addEventListener('shopify:section:unload',e=>{if(e.target?.contains(root))clearInterval(interval)});
})();
</script>

