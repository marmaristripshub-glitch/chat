</style>
<script>
(() => {
  const section = document.getElementById('mvpd-{{ section.id }}');
  if (!section || section.dataset.oneProductReady === '1') return;
  section.dataset.oneProductReady = '1';
  const $ = selector => section.querySelector(selector);
  const $$ = selector => Array.from(section.querySelectorAll(selector));
  const root = section.dataset.rootUrl || '/';
  const productId = {{ mv_p.id | json }};
  const variants = [
    {% for variant in mv_p.variants %}
      {id:{{ variant.id | json }},price:{{ variant.price | json }},compare:{{ variant.compare_at_price | default: 0 | json }},available:{{ variant.available | json }},min:{{ variant.quantity_rule.min | default: 1 | json }},inc:{{ variant.quantity_rule.increment | default: 1 | json }},max:{% if variant.quantity_rule.max != blank %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %},mediaId:{{ variant.featured_media.id | default: '' | json }},title:{{ variant.title | json }}}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  const variantSelect = $('[data-mvpd-variant]');
  const variantHidden = $('[data-mvpd-id]');
  const qtyInput = $('[data-mvpd-qty]');
  const checkout = $('[data-mvpd-checkout]');
  const checkoutLabel = $('[data-mvpd-checkout-label]');
  const originalCheckoutLabel = {{ section.settings.checkout_label | json }};
  const checkoutLoading = {{ section.settings.loading_button_label | json }};
  const unitText = {{ section.settings.quantity_unit | json }};
  const showCompare = {{ section.settings.show_compare_price | json }};
  const packDiscount2 = Number({{ section.settings.mv_pack_discount_2 | json }});
  const packDiscount3 = Number({{ section.settings.mv_pack_discount_3 | json }});
  const packs = $$('[data-mv-pack]');
  let selectedQty = Math.max(1, Number(qtyInput?.value)||1);
  const cartList = $('[data-mvpd-live-cart-list]');
  const cartCheck = $('[data-mvpd-cart-check]');
  const errorBox = $('[data-mvpd-error]');
  const cartURL = root + 'cart.js';
  let cart = null;
  let busy = false;
  let loadSerial = 0;
  let mutationSerial = 0;
  let currency = {{ cart.currency.iso_code | default: shop.currency | json }};

  function cash(cents) {
    try {return new Intl.NumberFormat('tr-TR',{style:'currency',currency:currency||'TRY',minimumFractionDigits:0,maximumFractionDigits:2}).format((Number(cents)||0)/100);}
    catch(e) {return ((Number(cents)||0)/100).toFixed(2)+' TL';}
  }
  function selectedVariant() {
    return variants.find(v=>String(v.id)===String(variantSelect?.value || variantHidden?.value)) || variants[0];
  }
  function packDiscountPct(qty) {
    if (qty === 2) return packDiscount2 || 0;
    if (qty === 3) return packDiscount3 || 0;
    return 0;
  }
  function packPreviewTotal(variant, qty) {
    const base = Number(variant?.price || 0) * Number(qty || 0);
    const pct = packDiscountPct(Number(qty || 0));
    if (!pct) return base;
    return Math.round(base * (100 - pct) / 100);
  }
  function set(selector,value) {const el=$(selector);if(el)el.textContent=value;}
  function visible(selector,on) {const el=$(selector);if(el)el.hidden=!on;}
  function showError(text) {if(errorBox){errorBox.textContent=text;errorBox.hidden=!text;}}
  function cartProductLines() {return cart?.items?.filter(item=>Number(item.product_id)===Number(productId))||[];}
  function countProduct() {return cartProductLines().reduce((sum,item)=>sum+item.quantity,0);}
  function syncHeader(count) {
    document.querySelectorAll('cart-icon').forEach(icon=>{try{icon.renderCartBubble?.(count,false);}catch(e){}});
    document.querySelectorAll('.cart-bubble').forEach(el=>{el.classList.toggle('visually-hidden',count===0);const countEl=el.querySelector('.cart-bubble__text-count');if(countEl){countEl.textContent=count<100?String(count):'';countEl.classList.toggle('hidden',count===0);}});
    try {sessionStorage.setItem('cart-count',JSON.stringify({value:String(count),timestamp:Date.now()}));}catch(e){}
    document.dispatchEvent(new CustomEvent('mv:cart-updated',{detail:{itemCount:count}}));
  }
  function showPreview() {
    const v=selectedVariant(); if(!v)return;
    if(variantHidden)variantHidden.value=v.id;
    set('[data-mvpd-unit]',cash(v.price));
    set('[data-mvpd-old]',cash(v.compare));visible('[data-mvpd-old]',showCompare && v.compare>v.price);
    if(qtyInput){qtyInput.min=v.min;qtyInput.step=v.inc;if(v.max)qtyInput.max=v.max;else qtyInput.removeAttribute('max');}
    packs.forEach(card=>{
      const qty=Number(card.dataset.qty);
      const allow=v.available&&qty>=v.min&&(!v.max||qty<=v.max)&&(qty-v.min)%v.inc===0;
      const btn=card.querySelector('[data-mv-pack-select]');if(btn)btn.disabled=!allow||busy;
      const total=card.querySelector('[data-mv-pack-price]');if(total)total.textContent=cash(packPreviewTotal(v, qty));
      const compare=card.querySelector('[data-mv-pack-compare]');if(compare){const pct=packDiscountPct(qty);compare.hidden=!pct;compare.textContent=cash(v.price*qty);}
      const saving=card.querySelector('[data-mv-pack-saving]');if(saving){saving.hidden=true;saving.textContent='';}
    });
    syncLocalSelection();
  }
  function itemImage(item) {return item.image||item.featured_image?.url||'';}
  function makeRow(item){
    const row=document.createElement('div');row.className='mvpd__summary-item mvpd__real-cart-item';
    const photo=document.createElement('img');photo.className='mvpd__summary-photo';photo.width=52;photo.height=52;photo.alt='';
    if(itemImage(item))photo.src=itemImage(item);else photo.hidden=true;
    const description=document.createElement('div');description.className='mvpd__summary-product';
    const name=document.createElement('strong');name.textContent=item.product_title||item.title||'Ürün';
    const variant=document.createElement('small');variant.textContent=item.variant_title&&item.variant_title!=='Default Title'?item.variant_title:'';
    const remove=document.createElement('button');remove.className='mvpd__bundle-remove';remove.type='button';remove.dataset.mvRemoveKey=item.key;remove.textContent='Ürünü kaldır';remove.disabled=busy;
    description.append(name,variant,remove);
    const price=document.createElement('div');price.className='mvpd__summary-item-price';
    const quantity=document.createElement('span');quantity.textContent=item.quantity+' '+unitText;
    const amount=document.createElement('strong');amount.textContent=cash(item.final_line_price??item.line_price??0);
    price.append(quantity,amount);row.append(photo,description,price);
    return row;
  }
  function renderCart(nextCart){
    cart=nextCart;currency=nextCart.currency||currency;
    const selectedCount=countProduct();
    const productLines=cartProductLines();
    if(cartList){cartList.replaceChildren(...(nextCart.items||[]).map(makeRow));cartList.hidden=!(nextCart.items||[]).length;}
    visible('[data-mvpd-base-summary]',false);
    visible('[data-mvpd-bundle-summary]',false);
    visible('[data-mvpd-summary-empty]',!(nextCart.items||[]).length);
    if(cartCheck){cartCheck.hidden=true;}
    const before=Number(nextCart.original_total_price??nextCart.total_price??0);
    const total=Number(nextCart.total_price??0);
    const discount=Math.max(0,before-total);
    set('[data-mvpd-subtotal]',cash(before));
    set('[data-mvpd-discount]',discount?'-'+cash(discount):'0');
    set('[data-mvpd-total]',cash(total));
    set('[data-mvpd-savings-amount]',cash(discount));
    visible('[data-mvpd-savings]',discount>0);
    const v=selectedVariant();
    packs.forEach(card=>{
      const qty=Number(card.dataset.qty);
      const chosen=selectedQty===qty;
      card.classList.toggle('is-summary-selected',chosen);
      const btn=card.querySelector('[data-mv-pack-select]');
      if(btn){btn.setAttribute('aria-pressed',String(chosen));btn.textContent=chosen?'✓ Seçildi':'Seç';btn.disabled=busy||!v?.available||qty<v.min||(v.max&&qty>v.max)||(qty-v.min)%v.inc!==0;}
      const price=card.querySelector('[data-mv-pack-price]');
      const compare=card.querySelector('[data-mv-pack-compare]');
      const saving=card.querySelector('[data-mv-pack-saving]');
      const preview=packPreviewTotal(v, qty);
      const savingAmount=Math.max(0,Number(v?.price||0)*qty-preview);
      if(price)price.textContent=cash(preview);
      if(compare){const pct=packDiscountPct(qty);compare.hidden=!pct;compare.textContent=pct?cash(v.price*qty):'';}
      if(saving){
        saving.hidden=!chosen||savingAmount<=0;
        saving.textContent=chosen&&savingAmount>0?'İndirim: -'+cash(savingAmount):'';
      }
    });
    // Never override the user's local quantity with a cart quantity.
    if(checkout)checkout.disabled=busy||!v?.available;
    syncHeader(Number(nextCart.item_count||0));
  }
  async function fetchCart(){const r=await fetch(cartURL,{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Shopify sepeti okunamadı.');return r.json();}
  async function postCart(path,data){const r=await fetch(root+path,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(data)});const body=await r.json().catch(()=>({}));if(!r.ok)throw new Error(body.description||body.message||'Shopify sepeti güncellenemedi.');return body;}
  // Notify Horizon cart components after a successful custom AJAX cart mutation.
  // Without this the custom summary updates while the native cart drawer stays stale.
  async function notifyHorizonCart(nextCart, action, sections) {
    try {
      const { CartLinesUpdateEvent } = await import('@shopify/events');
      const deferred = CartLinesUpdateEvent.createPromise();
      section.dispatchEvent(new CartLinesUpdateEvent({
        action: action || 'update',
        context: 'product',
        lines: (nextCart.items || []).map(item => ({
          id: String(item.key),
          merchandiseId: String(item.variant_id),
          quantity: Number(item.quantity)
        })),
        promise: deferred.promise
      }));
      deferred.resolve({
        cart: CartLinesUpdateEvent.createCartFromAjaxResponse(nextCart),
        detail: {
          sections: sections || undefined,
          items: nextCart.items || [],
          itemCount: Number(nextCart.item_count || 0),
          productId: String(productId),
          source: 'mvpd-product-information',
          didError: false
        }
      });
    } catch (error) {
      console.warn('[MarketVitrini] Horizon cart notification failed:', error);
    }
  }
  // React to Shopify drawer and native cart quantity changes in both directions.
  // The native event's promise resolves when the mutation is complete.
  document.addEventListener('shopify:cart:lines-update', event => {
    if (event.target === section || !event.promise) return;
    event.promise.then(() => {
      if (!busy) refresh();
      else mutationSerial++;
    }).catch(() => {});
  });
  async function refresh(){const serial=++loadSerial;try{const fresh=await fetchCart();if(serial===loadSerial){renderCart(fresh);showError('');}}catch(e){if(serial===loadSerial){showError(e.message);if(cartCheck){cartCheck.hidden=false;cartCheck.textContent='Sepete ulaşılamıyor';}if(checkout)checkout.disabled=true;}}}
  function busyUI(value){busy=value;packs.forEach(card=>{const btn=card.querySelector('[data-mv-pack-select]');if(btn)btn.disabled=value;});if(checkout)checkout.disabled=value||!selectedVariant()?.available;}
  // This affects only the product on this page; other unrelated cart items remain intact.
  async function setQuantity(value){
    const v=selectedVariant();if(!v||!v.available||busy)return;
    let qty=Math.max(0,Math.floor(Number(value)||0));
    if(qty>0&&(qty<v.min||(v.max&&qty>v.max)||(qty-v.min)%v.inc!==0)){showError('Seçilen adet bu ürünün miktar kurallarıyla uyumlu değil.');return;}
    const serial=++mutationSerial;
    busyUI(true);showError('');
    if(qtyInput)qtyInput.value=String(qty);
    if(cartCheck){cartCheck.hidden=false;cartCheck.textContent='Sepet güncelleniyor…';}
    try{
      const previous=cart || await fetchCart();
      const lines=previous.items.filter(item=>Number(item.product_id)===Number(productId));
      const same=lines.length===1&&Number(lines[0].variant_id)===Number(v.id);
      let updated;
      const withSections={sections:['cart-drawer-section'],sections_url:window.location.pathname};
      if(same){
        updated=lines[0].quantity===qty ? previous : await postCart('cart/change.js',{id:lines[0].key,quantity:qty,...withSections});
      }else{
        if(lines.length){const updates={};lines.forEach(item=>updates[item.key]=0);updated=await postCart('cart/update.js',{updates,...withSections});}
        if(qty>0){
          // cart/add.js returns added lines, not the full cart.
          updated=await postCart('cart/add.js',{items:[{id:v.id,quantity:qty}],...withSections});
        }
      }
      // cart/change.js and cart/update.js return authoritative full cart JSON;
      // cart/add.js returns only added items and needs one follow-up read.
      const fullCart=Array.isArray(updated?.items)&&Number.isFinite(Number(updated?.total_price)) ? updated : await fetchCart();
      if(serial!==mutationSerial)return;
      renderCart(fullCart);
      await notifyHorizonCart(fullCart,qty>0?'update':'remove',updated?.sections);
      showError('');
    }catch(e){showError(e.message||'Sepet değiştirilemedi.');await refresh();}
    finally{busyUI(false);if(cart)renderCart(cart);if(cartCheck)cartCheck.hidden=true;}
  }
  // Product gallery behavior is independent of package/cart selection.
  function switchMedia(id){
    if(!id)return;
    const all=$$('[data-mvpd-media]');if(!all.some(el=>el.dataset.mvpdMedia===String(id)))return;
    all.forEach(el=>{const active=el.dataset.mvpdMedia===String(id);el.hidden=!active;el.classList.toggle('is-active',active);if(!active)el.querySelectorAll('video').forEach(video=>video.pause());});
    $$('[data-mvpd-thumb]').forEach(el=>{const active=el.dataset.mvpdThumb===String(id);el.classList.toggle('is-active',active);el.setAttribute('aria-pressed',String(active));});
  }
  $$('[data-mvpd-thumb]').forEach(btn=>btn.addEventListener('click',()=>switchMedia(btn.dataset.mvpdThumb)));
  $('[data-mvpd-thumb-more]')?.addEventListener('click',()=>{const rail=$('.mvpd__thumbs');if(rail){const vertical=window.matchMedia('(min-width:601px)').matches;rail.scrollBy({top:vertical?140:0,left:vertical?0:170,behavior:'smooth'});}});
  variantSelect?.addEventListener('change',()=>{showPreview();const v=selectedVariant();document.dispatchEvent(new CustomEvent('mv:variant-change',{detail:{productId,variant:{id:v.id,price:v.price,compare_at_price:v.compare,available:v.available}}}));switchMedia(v.mediaId);});
  function syncLocalSelection(){
    const v=selectedVariant();
    selectedQty=Math.max(v?.min||1, Math.floor(Number(selectedQty)||1));
    if(v?.max)selectedQty=Math.min(selectedQty,v.max);
    if(qtyInput)qtyInput.value=String(selectedQty);
    const counter=$('[data-ref-qty]');if(counter)counter.textContent=String(selectedQty);
    const pct=packDiscountPct(selectedQty);
    const baseTotal=(v?.price||0)*selectedQty;
    const previewTotal=packPreviewTotal(v, selectedQty);
    set('[data-ref-order-qty]',String(selectedQty));
    set('[data-ref-order-subtotal]',cash(baseTotal));
    set('[data-ref-order-discount]',pct>0 ? '-'+cash(baseTotal-previewTotal) : cash(0));
    set('[data-ref-order-line]',cash(previewTotal));
    const price=$('[data-ref-price]');if(price)price.textContent=cash(previewTotal);
    const compare=$('[data-ref-compare]');
    if(compare){
      const showCompare = pct>0 ? baseTotal>previewTotal : (v?.compare>v?.price);
      compare.hidden=!showCompare;
      compare.textContent=showCompare ? cash(pct>0 ? baseTotal : (v.compare*selectedQty)) : '';
    }
    const discountBadge=$('[data-ref-discount]');
    if(discountBadge){
      if(pct>0){discountBadge.hidden=false;discountBadge.innerHTML='%' + pct + '<small>' + {{ section.settings.pack_discount_word | json }} + '</small>';}
      else if(v?.compare>v?.price){discountBadge.hidden=false;discountBadge.innerHTML='%' + Math.round(((v.compare-v.price)/v.compare)*100) + '<small>' + {{ section.settings.pack_discount_word | json }} + '</small>';}
      else {discountBadge.hidden=true;discountBadge.innerHTML='';}
    }
    set('[data-mvpd-unit]',cash(previewTotal));
    packs.forEach(card=>{
      const amount=Number(card.dataset.qty);
      const active=amount===selectedQty;
      card.classList.toggle('is-summary-selected',active);
      const btn=card.querySelector('[data-mv-pack-select]');
      if(btn){btn.textContent=active?{{ section.settings.pack_selected_label | json }}:{{ section.settings.pack_select_label | json }};btn.setAttribute('aria-pressed',String(active));btn.disabled=busy||!v?.available;}
      const saving=card.querySelector('[data-mv-pack-saving]');
      const savingAmount=Math.max(0,Number(v?.price||0)*amount-packPreviewTotal(v,amount));
      if(saving){saving.hidden=!active||savingAmount===0;saving.textContent=active&&savingAmount>0?'İndirim: -'+cash(savingAmount):'';}
    });
  }
  function previewQty(number){
    const v=selectedVariant();let next=Math.max(v?.min||1,Math.floor(Number(number)||1));
    if(v?.max)next=Math.min(next,v.max);
    if((next-(v?.min||1))%(v?.inc||1)!==0){showError('Bu ürünün adet artış kuralına uygun bir miktar seçin.');return;}
    selectedQty=next;showError('');syncLocalSelection();
  }
  packs.forEach(card=>card.querySelector('[data-mv-pack-select]')?.addEventListener('click',()=>previewQty(card.dataset.qty)));
  if(qtyInput){qtyInput.addEventListener('change',()=>previewQty(qtyInput.value));qtyInput.addEventListener('input',()=>{if(Number(qtyInput.value)>0)previewQty(qtyInput.value);});}
  $('[data-mvpd-minus]')?.addEventListener('click',()=>previewQty(selectedQty-(selectedVariant()?.inc||1)));
  $('[data-mvpd-plus]')?.addEventListener('click',()=>previewQty(selectedQty+(selectedVariant()?.inc||1)));
  $('[data-ref-minus]')?.addEventListener('click',()=>previewQty(selectedQty-(selectedVariant()?.inc||1)));
  $('[data-ref-plus]')?.addEventListener('click',()=>previewQty(selectedQty+(selectedVariant()?.inc||1)));
  async function addSelected(goCheckout){
    const v=selectedVariant();if(busy||!v?.available)return;
    if(selectedQty<v.min||(v.max&&selectedQty>v.max)||(selectedQty-v.min)%v.inc!==0){showError('Bu varyant için adet kuralı geçersiz.');return;}
    busyUI(true);showError('');
    try{
      const added=await postCart('cart/add.js',{items:[{id:v.id,quantity:selectedQty}],sections:['cart-drawer-section'],sections_url:window.location.pathname});
      const next=await fetchCart();renderCart(next);
      try { await notifyHorizonCart(next,'add',added?.sections); } catch (notifyError) { console.warn('Cart update notification:',notifyError); }
      if(goCheckout){window.location.assign(section.dataset.checkoutRedirect||root+'checkout');return;}
      window.location.assign(section.dataset.cartRedirect||root+'cart');
      return;
    }catch(error){showError(error.message||'Ürün sepete eklenemedi.');}
    finally{busyUI(false);}
  }
  $('[data-ref-add]')?.addEventListener('click',()=>addSelected(false));
  $('[data-ref-now]')?.addEventListener('click',()=>addSelected(true));
  cartList?.addEventListener('click',async e=>{const remove=e.target.closest('[data-mv-remove-key]');if(!remove||busy)return;busyUI(true);try{await postCart('cart/change.js',{id:remove.dataset.mvRemoveKey,quantity:0});const next=await fetchCart();renderCart(next);await notifyHorizonCart(next,'remove');showError('');}catch(err){showError(err.message);await refresh();}finally{busyUI(false);}});
  $('[data-mvpd-base-remove]')?.addEventListener('click',()=>setQuantity(0));
  $('[data-mvpd-bundle-remove]')?.addEventListener('click',()=>setQuantity(0));
  $('[data-mvpd-coupon-apply]')?.addEventListener('click',()=>{const input=$('[data-mvpd-coupon]');const msg=$('[data-mvpd-coupon-info]');if(msg)msg.hidden=!(input&&input.value.trim());});
  checkout?.addEventListener('click',()=>addSelected(true));
  function restore(){busy=false;if(checkoutLabel)checkoutLabel.textContent=originalCheckoutLabel;refresh();}
  window.addEventListener('pageshow',restore);
  window.addEventListener('focus',()=>{if(!busy)refresh();});
  document.addEventListener('visibilitychange',()=>{if(!document.hidden&&!busy)refresh();});
  showPreview();refresh();
})();
</script>

