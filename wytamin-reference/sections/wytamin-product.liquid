{% liquid
  assign mv_p = product | default: closest.product
  assign mv_v = mv_p.selected_or_first_available_variant
  assign mv_min = mv_v.quantity_rule.min | default: 1
  assign mv_inc = mv_v.quantity_rule.increment | default: 1
  assign mv_form_id = 'wy-form-' | append: section.id
  assign wy_rating = mv_p.metafields.reviews.rating.value.rating | default: section.settings.rating
  assign wy_count = mv_p.metafields.reviews.rating_count.value | default: section.settings.review_count | plus: 0
  assign wy_review_blocks = section.blocks | where: 'type', 'review'
  assign wy_pack_blocks = section.blocks | where: 'type', 'pack'
%}
<section id="wy-product-{{ section.id }}" class="wy-product" data-wy-product data-root-url="{{ routes.root_url }}" data-cart-url="{{ routes.cart_add_url }}.js" data-cart-redirect="{{ routes.cart_url }}" data-checkout-redirect="{{ routes.root_url }}checkout" data-next="{{ section.settings.purchase_destination }}" style="--wy-blue:{{ section.settings.blue }};--wy-red:{{ section.settings.red }};--wy-navy:{{ section.settings.navy }};--wy-width:{{ section.settings.max_width }}px">
<svg class="wy-symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><symbol id="wy-{{ section.id }}-cart" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l3 13h12l3-9H6"/></symbol><symbol id="wy-{{ section.id }}-shield" viewBox="0 0 24 24"><path d="m12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Z"/><path d="m8 12 3 3 5-6"/></symbol><symbol id="wy-{{ section.id }}-truck" viewBox="0 0 24 24"><path d="M1 5h13v13H1zM14 9h5l4 5v4h-9"/><circle cx="6" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></symbol><symbol id="wy-{{ section.id }}-box" viewBox="0 0 24 24"><path d="m12 2 9 5v10l-9 5-9-5V7l9-5Zm0 10 9-5M12 12 3 7m9 5v10M7.5 4.5l9 5"/></symbol><symbol id="wy-{{ section.id }}-headset" viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H2v8h5v-8H4Zm16 0h2v8h-5v-8h3Zm0 8c0 2-4 3-8 3"/></symbol><symbol id="wy-{{ section.id }}-heart" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 22l8.8-9.6a5.5 5.5 0 0 0 0-7.8Z"/></symbol><symbol id="wy-{{ section.id }}-return" viewBox="0 0 24 24"><path d="M3 10V4m0 6h6M4 8a9 9 0 1 1 1 12M12 7v6l4 2"/></symbol><symbol id="wy-{{ section.id }}-gift" viewBox="0 0 24 24"><rect x="3" y="9" width="18" height="13" rx="1"/><path d="M2 5h20v4H2zM12 5v17"/><path d="M12 5C2 6 4-3 9 2l3 3Zm0 0c10 1 8-8 3-3l-3 3Z"/></symbol><symbol id="wy-{{ section.id }}-drop" viewBox="0 0 24 24"><path d="M12 2S4 10 4 15a8 8 0 0 0 16 0c0-5-8-13-8-13Z"/><path d="M8 15a4 4 0 0 0 4 4"/></symbol><symbol id="wy-{{ section.id }}-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></symbol><symbol id="wy-{{ section.id }}-leaf" viewBox="0 0 24 24"><path d="M21 3C8 2 2 7 4 15c7 9 17 2 17-12ZM3 22 17 8M9 16l-1-6m5 2 6 1"/></symbol><symbol id="wy-{{ section.id }}-bone" viewBox="0 0 24 24"><path d="M5 6c-4-1-5 4-2 5l10 9c0 5 7 4 6 0 4 1 5-5 1-6L10 5c0-5-6-5-5 1Z"/></symbol><symbol id="wy-{{ section.id }}-skin" viewBox="0 0 24 24"><path d="M6 22v-3l3-5 1-9a2 2 0 0 1 4 0l1 9 3 5v3M8 13h8M6 19h12M4 5l-2 3m18-3 2 3"/></symbol><symbol id="wy-{{ section.id }}-peptide" viewBox="0 0 24 24"><path d="m6 3 15 15M3 6 18 21M5 7l2-2m1 5 2-2m1 5 2-2m1 5 2-2m1 5 2-2M4 2 2 4m20 16-2 2"/></symbol><symbol id="wy-{{ section.id }}-flame" viewBox="0 0 24 24"><path d="M13 2c2 6-3 6-1 10 2-1 3-3 3-5 4 3 7 9 3 13a9 9 0 0 1-13-1C1 13 6 8 8 6c-1 5 2 6 2 6s-1-7 3-10Z"/></symbol><symbol id="wy-{{ section.id }}-check" viewBox="0 0 24 24"><path d="m5 12 4 4L20 5"/></symbol><symbol id="wy-{{ section.id }}-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="12" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol><symbol id="wy-{{ section.id }}-tag" viewBox="0 0 24 24"><path d="M21 13 13 21 2 10V2h8l11 11Z"/><circle cx="7" cy="7" r="1.5"/></symbol><symbol id="wy-{{ section.id }}-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol><symbol id="wy-{{ section.id }}-bolt" viewBox="0 0 24 24"><path d="m13 2-9 12h7l-1 8L21 9h-8l1-7Z"/></symbol><symbol id="wy-{{ section.id }}-home" viewBox="0 0 24 24"><path d="m2 11 10-9 10 9M5 9v13h5v-7h4v7h5V9"/></symbol><symbol id="wy-{{ section.id }}-star" viewBox="0 0 24 24"><path d="m12 2 3 6 7 1-5 5 1 8-6-4-6 4 1-8-5-5 7-1 3-6Z"/></symbol><symbol id="wy-{{ section.id }}-user" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M3 23v-3a9 9 0 0 1 18 0v3H3Z"/></symbol><symbol id="wy-{{ section.id }}-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="7"/><path d="m15 15 7 7"/></symbol></defs></svg>
{% if mv_p == blank %}<p class="wy-empty">Bu bölümü bir ürün şablonunda kullanın.</p>{% else %}
<nav class="wy-breadcrumb" aria-label="İçerik yolu"><a href="{{ routes.root_url }}" aria-label="Ana sayfa"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-home"></use></svg></a><span aria-hidden="true">›</span><a href="{{ routes.all_products_collection_url }}">Ürünler</a><span aria-hidden="true">›</span>{% if mv_p.type != blank %}<span>{{ mv_p.type | escape }}</span><span aria-hidden="true">›</span>{% endif %}<span>{{ mv_p.title | escape }}</span></nav>
<div class="wy-layout">
 <div class="wy-main">
  <div class="wy-gallery" aria-label="Ürün görselleri">
   {% if mv_p.media.size > 1 %}<div class="wy-thumbnails" role="group" aria-label="Ürün görseli seçimi">{% for media in mv_p.media limit:12 %}<button type="button" class="wy-thumb{% if forloop.first %} is-active{% endif %}" data-mvpd-thumb="{{ media.id }}" aria-label="{{ forloop.index }}. görsel" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% if media.preview_image != blank %}{{ media.preview_image | image_url: width:160 | image_tag: loading:'lazy', alt:media.alt }}{% endif %}{% unless media.media_type == 'image' %}<span class="wy-play" aria-hidden="true">▶</span>{% endunless %}</button>{% endfor %}</div>{% endif %}
   <div class="wy-viewer">
    {% if section.settings.gallery_badge != blank %}<span class="wy-gallery-badge">{{ section.settings.gallery_badge | escape }}</span>{% endif %}
    {% if section.settings.gallery_stamp != blank %}{{ section.settings.gallery_stamp | image_url:width:280 | image_tag:loading:'lazy',class:'wy-gallery-stamp' }}{% endif %}
    {% for media in mv_p.media limit:12 %}
     <div class="wy-slide{% if forloop.first %} is-active{% endif %}" data-mvpd-media="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
      {% case media.media_type %}{% when 'image' %}{% assign image_loading = 'lazy' %}{% assign image_priority = 'auto' %}{% if forloop.first %}{% assign image_loading = 'eager' %}{% assign image_priority = 'high' %}{% endif %}{{ media | image_url:width:1400 | image_tag:loading:image_loading,fetchpriority:image_priority,widths:'360,540,750,1000,1400',sizes:'(max-width: 749px) 85vw, 32vw',alt:media.alt }}{% when 'video' %}{{ media | video_tag:controls:true,image_size:'1000x' }}{% when 'external_video' %}{{ media | external_video_tag }}{% else %}{{ media.preview_image | image_url:width:1200 | image_tag:loading:'lazy',alt:media.alt }}{% endcase %}
     </div>
    {% else %}{{ 'product-1' | placeholder_svg_tag:'wy-placeholder' }}{% endfor %}
    <div class="wy-gallery-controls"><button type="button" data-mvpd-prev aria-label="Önceki görsel">‹</button><span data-mvpd-gallery-count aria-live="polite">1 / {{ mv_p.media.size | at_least:1 }}</span><button type="button" data-mvpd-next aria-label="Sonraki görsel">›</button></div>
   </div>
  </div>
  <div class="wy-information">
   <h1>{{ mv_p.title | escape }}</h1>
   <div class="wy-rating-row">{% if wy_rating != blank and wy_count > 0 %}<span class="wy-stars" aria-hidden="true">★★★★★</span><strong>{{ wy_rating | escape }}</strong><span>({{ wy_count }} değerlendirme)</span>{% endif %}{% if section.settings.verified_seller %}<span class="wy-verified"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-shield"></use></svg>{{ section.settings.verified_label | escape }}</span>{% endif %}</div>
   {% if section.settings.subtitle != blank %}<h2>{{ section.settings.subtitle | escape }}</h2>{% endif %}
   {% if section.settings.description != blank %}<p class="wy-description">{{ section.settings.description | escape | newline_to_br }}</p>{% endif %}
   <div class="wy-benefits">{% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="wy-benefit" {{ block.shopify_attributes }}><span class="wy-benefit-icon"><svg class="wy-icon" aria-hidden="true"><use href="#wy-{{ section.id }}-{{ block.settings.icon }}"></use></svg></span><div><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.text | escape }}</small></div></div>{% endif %}{% endfor %}</div>
   <div class="wy-ingredients">{% for block in section.blocks %}{% if block.type == 'ingredient' %}<div class="wy-ingredient wy-tone-{{ block.settings.tone }}" {{ block.shopify_attributes }}><span><svg class="wy-icon" aria-hidden="true"><use href="#wy-{{ section.id }}-{{ block.settings.icon }}"></use></svg></span><div><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.text | escape }}</small></div></div>{% endif %}{% endfor %}</div>
   {% if section.settings.why_points != blank %}<div class="wy-why"><h3><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-shield"></use></svg>{{ section.settings.why_title | escape }}</h3><ul>{% assign why_lines = section.settings.why_points | newline_to_br | split:'<br />' %}{% for line in why_lines %}{% assign trimmed = line | strip %}{% if trimmed != blank %}<li><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-check"></use></svg></span>{{ trimmed | escape }}</li>{% endif %}{% endfor %}</ul></div>{% endif %}
  </div>
 </div>
 <aside class="wy-purchase" aria-label="Satın alma seçenekleri">
  {% if section.settings.campaign_end != blank %}<div class="wy-campaign" data-wy-campaign data-end="{{ section.settings.campaign_end | escape }}" hidden><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-flame"></use></svg><div><strong>{{ section.settings.campaign_heading | escape }}</strong><small data-wy-campaign-note>Bu fiyatlar için kalan süre:</small></div><div class="wy-countdown" data-wy-clock role="group" aria-label="Kampanya bitişine kalan süre"><span><b data-wy-hours>00</b><small>Saat</small></span><span><b data-wy-minutes>00</b><small>Dakika</small></span><span><b data-wy-seconds>00</b><small>Saniye</small></span></div></div>{% endif %}
  <div class="wy-buy-card">
   {% if wy_count > 0 %}<p class="wy-review-count"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-check"></use></svg>{{ wy_count }} kişi bu ürünü değerlendirdi</p>{% endif %}
   <div class="wy-price-row"><strong data-wy-price>{{ mv_v.price | times:mv_min | money_without_trailing_zeros }}</strong><s data-wy-compare{% unless mv_v.compare_at_price > mv_v.price %} hidden{% endunless %}>{{ mv_v.compare_at_price | times:mv_min | money_without_trailing_zeros }}</s><span class="wy-discount" data-wy-discount hidden><b data-wy-percent></b><small>İndirim</small></span></div>
   <div class="wy-stock"><p data-wy-stock-label>{% if mv_v.available %}Stokta{% else %}Tükendi{% endif %}</p><div class="wy-stock-track" data-wy-stock-track hidden><span data-wy-stock-fill></span></div></div>
   {% form 'product', mv_p, id:mv_form_id, class:'wy-product-form' %}
    {% unless mv_p.has_only_default_variant %}<label class="wy-label" for="wy-variant-{{ section.id }}">Seçenek</label><select id="wy-variant-{{ section.id }}" data-mvpd-variant name="id">{% for variant in mv_p.variants %}<option value="{{ variant.id }}"{% if variant.id == mv_v.id %} selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Tükendi{% endunless %}</option>{% endfor %}</select>{% endunless %}
    <input type="hidden" name="id" value="{{ mv_v.id }}" data-mvpd-id{% unless mv_p.has_only_default_variant %} disabled{% endunless %}>
    <div class="wy-quantity-row"><label for="wy-quantity-{{ section.id }}">Adet</label><div class="wy-quantity"><button type="button" data-mvpd-minus aria-label="Adedi azalt">−</button><input id="wy-quantity-{{ section.id }}" type="number" inputmode="numeric" name="quantity" data-mvpd-qty value="{{ mv_min }}" min="{{ mv_min }}" step="{{ mv_inc }}"{% if mv_v.quantity_rule.max != blank %} max="{{ mv_v.quantity_rule.max }}"{% endif %}><button type="button" data-mvpd-plus aria-label="Adedi artır">+</button></div><span class="wy-instock" data-wy-stock-badge{% unless mv_v.available %} hidden{% endunless %}>Stokta <svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-check"></use></svg></span></div>
    <button type="submit" class="wy-add" data-mvpd-add{% unless mv_v.available %} disabled{% endunless %}><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-cart"></use></svg><span data-mvpd-add-label>{% if mv_v.available %}{{ section.settings.add_label | escape }}{% else %}Tükendi{% endif %}</span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-arrow"></use></svg></button>
    <button type="button" class="wy-buy-now" data-wy-buy-now{% unless mv_v.available %} disabled{% endunless %}><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-bolt"></use></svg><span>{{ section.settings.buy_label | escape }}</span></button>
   {% endform %}
   <p class="wy-feedback" data-wy-status role="status" hidden></p><div class="wy-error" data-mvpd-error role="alert" hidden></div>
   <details class="wy-cart-details"><summary>Sepeti görüntüle <span data-wy-cart-count>{{ cart.item_count | default:0 }}</span></summary><p data-mvpd-cart-check role="status">Sepet kontrol ediliyor…</p><div data-mvpd-live-cart-list hidden></div><div data-mvpd-summary-empty hidden><p>Sepetiniz boş.</p><button type="button" data-mvpd-base-restore>1 adet ekle</button></div><div class="wy-cart-total"><span>Sepet toplamı</span><strong data-mvpd-total>{{ cart.total_price | money_without_trailing_zeros }}</strong></div><a href="{{ routes.cart_url }}">Sepete git →</a></details>
  </div>
  {% if section.settings.show_trust %}<div class="wy-trust-grid"><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-truck"></use></svg></span><p><strong>{{ section.settings.shipping_title | escape }}</strong><small>{{ section.settings.shipping_note | escape }}</small></p></div><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-box"></use></svg></span><p><strong>{{ section.settings.dispatch_title | escape }}</strong><small>{{ section.settings.dispatch_note | escape }}</small></p></div><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-shield"></use></svg></span><p><strong>Güvenli Ödeme</strong><small>Shopify altyapısı</small></p></div><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-return"></use></svg></span><p><strong>{{ section.settings.return_title | escape }}</strong><small>{{ section.settings.return_note | escape }}</small></p></div><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-heart"></use></svg></span><p><strong>{{ section.settings.support_title | escape }}</strong><small>{{ section.settings.support_note | escape }}</small></p></div><div><span><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-gift"></use></svg></span><p><strong>{{ section.settings.authenticity_title | escape }}</strong><small>{{ section.settings.authenticity_note | escape }}</small></p></div></div>{% endif %}
  <div class="wy-security"><div><span class="wy-security-shield"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-shield"></use></svg></span><p><strong>{{ section.settings.security_title | escape }}</strong><small>{{ section.settings.security_note | escape }}</small></p></div>{% if shop.enabled_payment_types.size > 0 %}<ul class="wy-payments" role="list" aria-label="Ödeme yöntemleri">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag:class:'wy-payment-logo' }}</li>{% endfor %}</ul>{% endif %}</div>
 </aside>
 <div class="wy-lower">
  {% if wy_pack_blocks.size > 0 %}<section class="wy-packages" aria-labelledby="wy-pack-title-{{ section.id }}"><div class="wy-section-bar"><h2 id="wy-pack-title-{{ section.id }}"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-tag"></use></svg>{{ section.settings.pack_title | escape }}</h2><span>{{ section.settings.pack_note | escape }}</span></div><div class="wy-pack-grid">
  {% for block in wy_pack_blocks %}{% liquid
   assign pack_qty = block.settings.qty
   assign pack_image = block.settings.image | default:mv_p.featured_image
   assign pack_price = mv_v.price | times:pack_qty
  %}<article class="wy-pack{% if block.settings.featured %} wy-pack-featured{% endif %}" data-mv-pack data-qty="{{ pack_qty }}" {{ block.shopify_attributes }}>{% if block.settings.featured %}<span class="wy-pack-ribbon">{{ section.settings.featured_label | escape }}</span>{% endif %}<div class="wy-pack-visual" aria-hidden="true">{% if pack_image != blank %}{% if block.settings.image != blank %}{{ pack_image | image_url:width:320 | image_tag:loading:'lazy',alt:'' }}{% else %}{% for copy in (1..pack_qty) limit:3 %}{{ pack_image | image_url:width:240 | image_tag:loading:'lazy',alt:'' }}{% endfor %}{% endif %}{% endif %}</div><div class="wy-pack-info"><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}<div class="wy-pack-prices"><s data-wy-pack-old hidden></s><strong data-mv-pack-price>{{ pack_price | money_without_trailing_zeros }}</strong></div><small data-mv-pack-saving hidden></small></div><button type="button" data-mv-pack-select aria-pressed="false"{% unless mv_v.available %} disabled{% endunless %}>Seç</button></article>{% endfor %}
  </div></section>{% endif %}
  {% if wy_review_blocks.size > 0 %}<section class="wy-reviews" aria-labelledby="wy-review-title-{{ section.id }}"><div class="wy-review-heading"><h2 id="wy-review-title-{{ section.id }}"><svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-star"></use></svg>{{ section.settings.reviews_heading | escape }}</h2>{% if section.settings.reviews_link != blank %}<a href="{{ section.settings.reviews_link }}">Tüm Yorumları Gör <svg class="wy-icon " aria-hidden="true"><use href="#wy-{{ section.id }}-arrow"></use></svg></a>{% endif %}</div><div class="wy-review-grid">{% for block in wy_review_blocks %}{% if block.settings.text != blank %}<article class="wy-review" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url:width:160 | image_tag:loading:'lazy',class:'wy-review-photo',alt:block.settings.name }}{% endif %}<div><span class="wy-review-stars" role="img" aria-label="5 üzerinden {{ block.settings.stars }} puan">{% for star in (1..5) %}<span{% if star > block.settings.stars %} class="wy-star-empty"{% endif %}>★</span>{% endfor %}</span><small class="wy-score">{{ block.settings.stars }}/5</small><p>“{{ block.settings.text | escape }}”</p><footer>{{ block.settings.name | escape }}{% if block.settings.date != blank %}<span> · {{ block.settings.date | escape }}</span>{% endif %}</footer></div></article>{% endif %}{% endfor %}</div></section>{% endif %}
 </div>
</div>
{% for block in section.blocks %}{% if block.type == '@app' %}<div class="wy-app">{% render block %}</div>{% endif %}{% endfor %}
{% endif %}
{% capture wy_config %}{
 "productId":{{ mv_p.id | json }},"checkoutLabel":{{ section.settings.buy_label | json }},"loadingLabel":{{ section.settings.loading_label | json }},"unitText":"adet","showCompare":true,"currency":{{ cart.currency.iso_code | default:shop.currency | json }},"addLabel":{{ section.settings.add_label | json }},"soldLabel":"Tükendi","manualSaving":null,"packLabel":"Seç","stockReference":{{ section.settings.stock_reference | json }},
 "variants":[{% for variant in mv_p.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | default:0 | json }},"available":{{ variant.available | json }},"min":{{ variant.quantity_rule.min | default:1 | json }},"inc":{{ variant.quantity_rule.increment | default:1 | json }},"max":{% if variant.quantity_rule.max != blank %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %},"mediaId":{{ variant.featured_media.id | default:'' | json }},"title":{{ variant.title | json }},"inventory":{{ variant.inventory_quantity | default:0 | json }},"managed":{{ variant.inventory_management | json }},"policy":{{ variant.inventory_policy | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}{% endcapture %}<script type="application/json" data-wy-config>{{ wy_config | replace:'<','\u003c' }}</script>
</section>

<style>
#wy-product-{{ section.id }}{max-width:var(--wy-width);margin:0 auto;padding:12px 24px 28px;color:var(--wy-navy);background:#fff;font-family:var(--font-body--family,Arial,sans-serif);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}
#wy-product-{{ section.id }} *,#wy-product-{{ section.id }} *::before,#wy-product-{{ section.id }} *::after{box-sizing:border-box}
#wy-product-{{ section.id }} [hidden]{display:none!important}
#wy-product-{{ section.id }} .wy-symbols{position:absolute;width:0;height:0;overflow:hidden}
#wy-product-{{ section.id }} :is(h1,h2,h3,p){margin:0;overflow-wrap:anywhere}
#wy-product-{{ section.id }} :is(button,input,select){font:inherit}
#wy-product-{{ section.id }} button{cursor:pointer;touch-action:manipulation}
#wy-product-{{ section.id }} button:disabled{opacity:.45;cursor:not-allowed}
#wy-product-{{ section.id }} :is(button,a,input,select,summary):focus-visible{outline:3px solid var(--wy-blue);outline-offset:3px;box-shadow:0 0 0 5px #fff}
#wy-product-{{ section.id }} .wy-icon{display:block;width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
#wy-product-{{ section.id }} .wy-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:11px;margin-bottom:16px;color:#3e4b6c}
#wy-product-{{ section.id }} .wy-breadcrumb a{color:inherit;text-decoration:none}
