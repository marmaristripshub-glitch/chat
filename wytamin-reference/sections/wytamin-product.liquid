-{{ section.id }} select,#wy-product-{{ section.id }} .wy-quantity input{font-size:16px}#wy-product-{{ section.id }} select{min-height:44px}#wy-product-{{ section.id }} .wy-trust-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 8px}#wy-product-{{ section.id }} .wy-trust-grid>div{display:block;text-align:center}#wy-product-{{ section.id }} .wy-trust-grid>div>span{margin:0 auto 6px}#wy-product-{{ section.id }} .wy-trust-grid strong,#wy-product-{{ section.id }} .wy-trust-grid small{font-size:9px}#wy-product-{{ section.id }} .wy-section-bar{padding:10px}#wy-product-{{ section.id }} .wy-section-bar h2{font-size:15px}#wy-product-{{ section.id }} .wy-section-bar>span{font-size:10px}#wy-product-{{ section.id }} .wy-pack-grid{gap:8px}#wy-product-{{ section.id }} .wy-pack{min-height:188px;padding:15px 7px 9px;gap:7px;border-radius:9px}#wy-product-{{ section.id }} .wy-pack-visual{height:78px}#wy-product-{{ section.id }} .wy-pack-info h3{font-size:13px}#wy-product-{{ section.id }} .wy-pack-info>p{font-size:10px}#wy-product-{{ section.id }} .wy-pack-prices>strong{font-size:20px;overflow-wrap:anywhere}#wy-product-{{ section.id }} .wy-pack>button{min-height:40px;font-size:11px}#wy-product-{{ section.id }} .wy-pack-ribbon{font-size:8px}#wy-product-{{ section.id }} .wy-review-heading h2{font-size:13px}#wy-product-{{ section.id }} .wy-review-heading a{font-size:10px}#wy-product-{{ section.id }} .wy-review-grid{grid-template-columns:1fr}#wy-product-{{ section.id }} .wy-review p{font-size:12px}#wy-product-{{ section.id }} .wy-review footer{font-size:10px}#wy-product-{{ section.id }} .wy-gallery-controls button{width:34px;height:34px}}
