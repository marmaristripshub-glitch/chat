<script>
(() => {
  if(window.__MVProductStudio){window.__MVProductStudio.scan(document);return;}
  const instances=new Map();
  function initialize(section){
    if(instances.has(section)||!section.querySelector('.mvpd__form'))return;
    const configElement=section.querySelector('[data-mvpd-config]');
    if(!configElement)return;
    const config=JSON.parse(configElement.textContent);
    const controller=new AbortController();
    const listen=(target,type,handler)=>target.addEventListener(type,handler,{signal:controller.signal});
  const $ = selector => section.querySelector(selector);
  const $$ = selector => Array.from(section.querySelectorAll(selector));
  const root = (section.dataset.rootUrl || '/').replace(/\/?$/, '/');
  const productId = config.productId;
  const variants = config.variants;
  const variantSelect = $('[data-mvpd-variant]');
  const variantHidden = $('[data-mvpd-id]');
  const qtyInput = $('[data-mvpd-qty]');
  const checkout = $('[data-mvpd-checkout]');
  const checkoutLabel = $('[data-mvpd-checkout-label]');
  const originalCheckoutLabel = config.checkoutLabel;
  const checkoutLoading = config.loadingLabel;
  const unitText = config.unitText;
  const showCompare = config.showCompare;
  const packs = $$('[data-mv-pack]');
  const cartList = $('[data-mvpd-live-cart-list]');
  const cartCheck = $('[data-mvpd-cart-check]');
  const errorBox = $('[data-mvpd-error]');
  const cartURL = root + 'cart.js';
  let cart = null;
  let busy = false;
  let loadSerial = 0;
  let mutationSerial = 0;
  let needsRefresh = false;
  const add = $('[data-mvpd-add]');
  const form = $('.mvpd__form');
  const formatterCache = new Map();
  let currency = config.currency;

  function cash(cents) {
    const locale = document.documentElement.lang || 'tr-TR';
    const key = locale + ':' + currency + ':' + (Number(cents)%100===0?0:2);
    try {
      if (!formatterCache.has(key)) formatterCache.set(key, new Intl.NumberFormat(locale, {style:'currency',currency:currency||'TRY',minimumFractionDigits:Number(cents)%100===0?0:2,maximumFractionDigits:2}));
      return formatterCache.get(key).format((Number(cents)||0)/100);
    } catch { return ((Number(cents)||0)/100).toFixed(2); }
  }
  function selectedVariant() {
    return variants.find(v=>String(v.id)===String(variantSelect?.value || variantHidden?.value)) || variants[0];
  }
  function set(selector,value) {const el=$(selector);if(el)el.textContent=value;}
  function visible(selector,on) {const el=$(selector);if(el)el.hidden=!on;}
  function showError(text) {if(errorBox){errorBox.textContent=text;errorBox.hidden=!text;}}
  function cartProductLines() {return cart?.items?.filter(item=>Number(item.product_id)===Number(productId) && !item.selling_plan_allocation && !item.parent_relationship && !Object.keys(item.properties||{}).length)||[];}
  function countProduct() {return cartProductLines().reduce((sum,item)=>sum+item.quantity,0);}
  function syncHeader(count) {
    document.querySelectorAll('cart-icon').forEach(icon=>{try{icon.renderCartBubble?.(count,false);}catch(e){}});
    document.querySelectorAll('.cart-bubble').forEach(el=>{el.classList.toggle('visually-hidden',count===0);const countEl=el.querySelector('.cart-bubble__text-count');if(countEl){countEl.textContent=count<100?String(count):'';countEl.classList.toggle('hidden',count===0);}});
    try {sessionStorage.setItem('cart-count',JSON.stringify({value:String(count),timestamp:Date.now()}));}catch(e){}
    document.dispatchEvent(new CustomEvent('mv:cart-updated',{detail:{itemCount:count}}));
  }
  function showPreview() {
    const v=selectedVariant(); if(!v)return;
    if(variantHidden)variantHidden.value=v.id;
    set('[data-mvpd-unit]',cash(v.price));
    set('[data-mvpd-old]',cash(v.compare));visible('[data-mvpd-old]',showCompare && v.compare>v.price);
    if(qtyInput){qtyInput.min=v.min;qtyInput.step=v.inc;if(v.max)qtyInput.max=v.max;else qtyInput.removeAttribute('max');}
    const saving = Math.max(0, v.compare - v.price);
    if (config.manualSaving) set('[data-mvpd-save-amount]', config.manualSaving);
    else set('[data-mvpd-save-amount]', cash(saving));
    visible('[data-mvpd-save]', Boolean(config.manualSaving || saving > 0));
    set('[data-mvpd-add-label]', v.available ? config.addLabel : config.soldLabel);
    if (add) add.disabled = busy || !v.available;
    set('[data-mvpd-selected-title]',v.title === 'Default Title' ? '' : v.title);

    packs.forEach(card=>{
      const qty=Number(card.dataset.qty);
      const allow=v.available&&qty>=v.min&&(!v.max||qty<=v.max)&&(qty-v.min)%v.inc===0;
      const btn=card.querySelector('[data-mv-pack-select]');if(btn)btn.disabled=!allow||busy;
      const total=card.querySelector('[data-mv-pack-price]');if(total)total.textContent=cash(v.price*qty);
      const unit=card.querySelector('[data-mv-pack-unit]');if(unit)unit.textContent=cash(v.price)+' / '+unitText;
      const saving=card.querySelector('[data-mv-pack-saving]');if(saving){saving.hidden=true;saving.textContent='';}
    });
    if(cart)renderCart(cart);
  }
  function itemImage(item) {return item.image||item.featured_image?.url||'';}
  function makeRow(item){
    const row=document.createElement('div');row.className='mvpd__summary-item mvpd__real-cart-item';
    const photo=document.createElement('img');photo.className='mvpd__summary-photo';photo.width=52;photo.height=52;photo.alt='';photo.loading='lazy';
    if(itemImage(item))photo.src=itemImage(item);else photo.hidden=true;
    const description=document.createElement('div');description.className='mvpd__summary-product';
    const name=document.createElement('strong');name.textContent=item.product_title||item.title||'Ürün';
    const variant=document.createElement('small');variant.textContent=item.variant_title&&item.variant_title!=='Default Title'?item.variant_title:'';
    const remove=document.createElement('button');remove.className='mvpd__bundle-remove';remove.type='button';remove.dataset.mvRemoveKey=item.key;remove.textContent='Kaldır';remove.setAttribute('aria-label',(item.product_title||item.title||'Ürün')+' ürününü sepetten kaldır');remove.disabled=busy;
    description.append(name,variant,remove);
    const price=document.createElement('div');price.className='mvpd__summary-item-price';
    const quantity=document.createElement('span');quantity.textContent=item.quantity+' '+unitText;
    const amount=document.createElement('strong');amount.textContent=cash(item.final_line_price??item.line_price??0);
    price.append(quantity,amount);row.append(photo,description,price);
    return row;
  }
  function renderCart(nextCart){
    cart=nextCart;currency=nextCart.currency||currency;
    const selectedCount=countProduct();
    const productLines=cartProductLines();
    if(cartList){cartList.replaceChildren(...(nextCart.items||[]).map(makeRow));cartList.hidden=!(nextCart.items||[]).length;}
    visible('[data-mvpd-base-summary]',false);
    visible('[data-mvpd-bundle-summary]',false);
    visible('[data-mvpd-summary-empty]',!(nextCart.items||[]).length);
    if(cartCheck){cartCheck.hidden=true;}
    const before=Number(nextCart.original_total_price??nextCart.total_price??0);
    const total=Number(nextCart.total_price??0);
    const discount=Math.max(0,before-total);
    set('[data-mvpd-subtotal]',cash(before));
    set('[data-mvpd-discount]',discount?'-'+cash(discount):cash(0));
    visible('[data-mvpd-discount-row]',discount>0);
    set('[data-mvpd-total]',cash(total));
    set('[data-mvpd-savings-amount]',cash(discount));
    visible('[data-mvpd-savings]',discount>0);
    const v=selectedVariant();
    packs.forEach(card=>{
      const qty=Number(card.dataset.qty);
      const chosen=productLines.length>0 && productLines.every(line=>Number(line.variant_id)===Number(v?.id)) && productLines.reduce((sum,line)=>sum+line.quantity,0)===qty;
      card.classList.toggle('is-summary-selected',chosen);
      const btn=card.querySelector('[data-mv-pack-select]');
      if(btn){btn.setAttribute('aria-pressed',String(chosen));btn.textContent=chosen?'✓ Seçildi':config.packLabel;btn.disabled=busy||!v?.available||qty<v.min||(v.max&&qty>v.max)||(qty-v.min)%v.inc!==0;}
      const price=card.querySelector('[data-mv-pack-price]');
      const saving=card.querySelector('[data-mv-pack-saving]');
      const line=chosen?productLines[0]:null;
      const net=chosen?productLines.reduce((sum,line)=>sum+Number(line.final_line_price??line.line_price),0):v.price*qty;
      if(price)price.textContent=cash(net);
      if(saving){const actual=chosen?Math.max(0,productLines.reduce((sum,line)=>sum+Number(line.original_line_price??line.line_price),0)-net):0;saving.hidden=!actual;saving.textContent=actual?'Shopify indirimi: -'+cash(actual):'';}
    });
    if(qtyInput && selectedCount>0 && productLines.every(line=>String(line.variant_id)===String(v?.id)))qtyInput.value=String(selectedCount);
    if(checkout)checkout.disabled=busy||!nextCart.item_count;
    syncHeader(Number(nextCart.item_count||0));
  }
  async function fetchCart(){const r=await fetch(cartURL,{credentials:'same-origin',cache:'no-store',signal:controller.signal,headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Shopify sepeti okunamadı.');return r.json();}
  async function postCart(path,data){const r=await fetch(root+path,{method:'POST',credentials:'same-origin',signal:controller.signal,headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(data)});const body=await r.json().catch(()=>({}));if(!r.ok)throw new Error(body.description||body.message||'Shopify sepeti güncellenemedi.');return body;}
  // Notify Horizon cart components after a successful custom AJAX cart mutation.
  // Without this the custom summary updates while the native cart drawer stays stale.
  async function notifyHorizonCart(nextCart, action, sections) {
    try {
      const { CartLinesUpdateEvent } = await import('@shopify/events');
      const deferred = CartLinesUpdateEvent.createPromise();
      section.dispatchEvent(new CartLinesUpdateEvent({
        action: action || 'update',
        context: 'product',
        lines: (nextCart.items || []).map(item => ({
          id: String(item.key),
          merchandiseId: String(item.variant_id),
          quantity: Number(item.quantity)
        })),
        promise: deferred.promise
      }));
      deferred.resolve({
        cart: CartLinesUpdateEvent.createCartFromAjaxResponse(nextCart),
        detail: {
          sections: sections || undefined,
          items: nextCart.items || [],
          itemCount: Number(nextCart.item_count || 0),
          productId: String(productId),
          source: 'mvpd-product-information',
          didError: false
        }
      });
    } catch (error) {
      console.warn('[MarketVitrini] Horizon cart notification failed:', error);
    }
  }
  // React to Shopify drawer and native cart quantity changes in both directions.
  // The native event's promise resolves when the mutation is complete.
  listen(document,'shopify:cart:lines-update', event => {
    if (event.target === section || !event.promise) return;
    event.promise.then(() => {
      if (!busy) refresh();
      else needsRefresh=true;
    }).catch(() => {});
  });
  async function refresh(){if(busy||controller.signal.aborted)return;const serial=++loadSerial;try{const fresh=await fetchCart();if(serial===loadSerial){renderCart(fresh);}}catch(e){if(serial===loadSerial&&!controller.signal.aborted){showError(e.message);if(cartCheck){cartCheck.hidden=false;cartCheck.textContent='Sepete ulaşılamıyor';}if(checkout)checkout.disabled=true;}}}
  function busyUI(value) {
    busy=value;
    section.setAttribute('aria-busy',String(value));
    if(variantSelect)variantSelect.disabled=value;
    if(qtyInput)qtyInput.disabled=value;
    if(add)add.disabled=value||!selectedVariant()?.available;
    $$('[data-mvpd-minus],[data-mvpd-plus],[data-mv-remove-key]').forEach(button=>button.disabled=value);
    packs.forEach(card=>{const button=card.querySelector('[data-mv-pack-select]');if(button)button.disabled=value;});
    if(checkout)checkout.disabled=value||!cart?.item_count;
    if(!value)showPreview();
  }
  // This affects only the product on this page; other unrelated cart items remain intact.
  async function setQuantity(value){
    const v=selectedVariant();if(!v||busy)return;
    let qty=Math.max(0,Math.floor(Number(value)||0));
    if(qty>0&&!v.available){showError('Bu seçenek şu anda stokta yok.');return;}
    if(qty>0&&(qty<v.min||(v.max&&qty>v.max)||(qty-v.min)%v.inc!==0)){showError('Seçilen adet bu ürünün miktar kurallarıyla uyumlu değil.');return;}
    const serial=++mutationSerial;
    loadSerial++;
    busyUI(true);showError('');
    if(qtyInput)qtyInput.value=String(qty);
    if(cartCheck){cartCheck.hidden=false;cartCheck.textContent='Sepet güncelleniyor…';}
    try{
      const previous=await fetchCart();
      const lines=previous.items.filter(item=>Number(item.product_id)===Number(productId) && !item.selling_plan_allocation && !item.parent_relationship && !Object.keys(item.properties||{}).length);
      const same=lines.length===1&&Number(lines[0].variant_id)===Number(v.id);
      let updated;
      const ids=[...new Set([...document.querySelectorAll('cart-items-component[data-section-id]')].map(el=>el.dataset.sectionId).filter(Boolean))].slice(0,5);
      const withSections={sections:ids,sections_url:window.location.pathname};
      if(same){
        updated=lines[0].quantity===qty ? previous : await postCart('cart/change.js',{id:lines[0].key,quantity:qty,...withSections});
      }else{
        if(qty>0) await postCart('cart/add.js',{items:[{id:v.id,quantity:qty}],...withSections});
        if(lines.length){const updates={};lines.forEach(item=>updates[item.key]=0);updated=await postCart('cart/update.js',{updates,...withSections});}
        else updated=await fetchCart();
      }
      // cart/change.js and cart/update.js return authoritative full cart JSON;
      // cart/add.js returns only added items and needs one follow-up read.
      const fullCart=Array.isArray(updated?.items)&&Number.isFinite(Number(updated?.total_price)) ? updated : await fetchCart();
      if(serial!==mutationSerial)return;
      renderCart(fullCart);
      await notifyHorizonCart(fullCart,qty>0?'update':'remove',updated?.sections);
      showError('');
    }catch(e){if(e.name!=='AbortError'){showError(e.message||'Sepet değiştirilemedi.');try{renderCart(await fetchCart());}catch{}}}
    finally{busyUI(false);if(cart)renderCart(cart);if(cartCheck)cartCheck.hidden=true;if(needsRefresh){needsRefresh=false;refresh();}}
  }
  // Product gallery behavior is independent of package/cart selection.
  function switchMedia(id){
    if(!id)return;
    const all=$$('[data-mvpd-media]');if(!all.some(el=>el.dataset.mvpdMedia===String(id)))return;
    all.forEach(el=>{const active=el.dataset.mvpdMedia===String(id);el.hidden=!active;el.classList.toggle('is-active',active);if(!active)el.querySelectorAll('video').forEach(video=>video.pause());});
    $$('[data-mvpd-thumb]').forEach(el=>{const active=el.dataset.mvpdThumb===String(id);el.classList.toggle('is-active',active);el.setAttribute('aria-pressed',String(active));});
    const index=all.findIndex(el=>el.dataset.mvpdMedia===String(id));set('[data-mvpd-gallery-count]',(index+1)+' / '+all.length);
  }
  $$('[data-mvpd-thumb]').forEach(btn=>btn.addEventListener('click',()=>switchMedia(btn.dataset.mvpdThumb)));
  function nextMedia(direction){const all=$$('[data-mvpd-media]');if(all.length<2)return;const index=all.findIndex(el=>!el.hidden);switchMedia(all[(index+direction+all.length)%all.length].dataset.mvpdMedia);}
  $('[data-mvpd-prev]')?.addEventListener('click',()=>nextMedia(-1));
  $('[data-mvpd-next]')?.addEventListener('click',()=>nextMedia(1));
  $('.mvpd__thumbs')?.addEventListener('keydown',event=>{
    if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;
    const thumbs=$$('[data-mvpd-thumb]');const index=thumbs.indexOf(event.target);if(index<0)return;
    event.preventDefault();
    const next=event.key==='Home'?0:event.key==='End'?thumbs.length-1:(index+(event.key==='ArrowRight'?1:-1)+thumbs.length)%thumbs.length;
    thumbs[next].click();thumbs[next].focus();
  });
  const media=$$('[data-mvpd-media]');
  set('[data-mvpd-gallery-count]','1 / '+Math.max(1,media.length));
  $$('[data-mvpd-prev],[data-mvpd-next]').forEach(button=>button.disabled=media.length<2);

  $('[data-mvpd-thumb-more]')?.addEventListener('click',()=>{const rail=$('.mvpd__thumbs');if(rail){const vertical=window.matchMedia('(min-width:601px)').matches;rail.scrollBy({top:vertical?140:0,left:vertical?0:170,behavior:'smooth'});}});
  variantSelect?.addEventListener('change',()=>{if(qtyInput)qtyInput.value=String(selectedVariant()?.min||1);showPreview();const v=selectedVariant();document.dispatchEvent(new CustomEvent('mv:variant-change',{detail:{productId,variant:{id:v.id,price:v.price,compare_at_price:v.compare,available:v.available}}}));switchMedia(v.mediaId);});
  packs.forEach(card=>card.querySelector('[data-mv-pack-select]')?.addEventListener('click',()=>setQuantity(Number(card.dataset.qty))));
  $('[data-mvpd-base-restore]')?.addEventListener('click',()=>setQuantity(selectedVariant()?.min||1));
  function adjust(value){
    const variant=selectedVariant();if(!variant||busy)return;
    const raw=Number(value);const min=variant.min||1;const inc=variant.inc||1;
    let next=Math.max(min,min+Math.round(((Number.isFinite(raw)?raw:min)-min)/inc)*inc);
    if(variant.max)next=Math.min(next,min+Math.floor((variant.max-min)/inc)*inc);
    qtyInput.value=String(next);
    if(cartProductLines().length)setQuantity(next);
  }
  qtyInput?.addEventListener('change',()=>adjust(qtyInput.value));
  $('[data-mvpd-minus]')?.addEventListener('click',()=>adjust(Number(qtyInput?.value)-(selectedVariant()?.inc||1)));
  $('[data-mvpd-plus]')?.addEventListener('click',()=>adjust(Number(qtyInput?.value)+(selectedVariant()?.inc||1)));
  form?.addEventListener('submit',async event=>{
    event.preventDefault();if(busy)return;
    set('[data-mvpd-add-label]',config.loadingLabel);
    await setQuantity(Number(qtyInput?.value)||selectedVariant()?.min||1);
    set('[data-mvpd-add-label]',selectedVariant()?.available?config.addLabel:config.soldLabel);
  });
  cartList?.addEventListener('click',async e=>{const remove=e.target.closest('[data-mv-remove-key]');if(!remove||busy)return;busyUI(true);try{await postCart('cart/change.js',{id:remove.dataset.mvRemoveKey,quantity:0});const next=await fetchCart();renderCart(next);await notifyHorizonCart(next,'remove');showError('');}catch(err){if(err.name!=='AbortError')showError(err.message);}finally{busyUI(false);}});
  $('[data-mvpd-base-remove]')?.addEventListener('click',()=>setQuantity(0));
  $('[data-mvpd-bundle-remove]')?.addEventListener('click',()=>setQuantity(0));
  $('[data-mvpd-coupon-apply]')?.addEventListener('click',()=>{const input=$('[data-mvpd-coupon]');const msg=$('[data-mvpd-coupon-info]');if(msg)msg.hidden=!(input&&input.value.trim());});
  checkout?.addEventListener('click',async()=>{
    if(busy)return;busyUI(true);if(checkoutLabel)checkoutLabel.textContent=checkoutLoading;
    try{
      const fresh=await fetchCart();renderCart(fresh);
      if(!fresh.item_count)throw new Error('Sepet boş. Önce paket seçin.');
      const coupon=$('[data-mvpd-coupon]')?.value.trim();
      const route=section.dataset.next==='cart'?'cart':'checkout';
      if(coupon)window.location.assign(root+'discount/'+encodeURIComponent(coupon)+'?redirect='+encodeURIComponent(root+route));
      else window.location.assign(route==='cart'?section.dataset.cartRedirect:section.dataset.checkoutRedirect);
    }catch(e){showError(e.message);busyUI(false);if(checkoutLabel)checkoutLabel.textContent=originalCheckoutLabel;}
  });
  function restore(event){if(event.persisted){busyUI(false);if(checkoutLabel)checkoutLabel.textContent=originalCheckoutLabel;}if(!busy)refresh();}
  listen(window,'pageshow',restore);
  listen(window,'focus',()=>{if(!busy)refresh();});
  listen(document,'visibilitychange',()=>{if(!document.hidden&&!busy)refresh();});
  showPreview();refresh();
  return () => controller.abort();

  }
  function scan(scope){
    const roots=[...scope.querySelectorAll('[data-mvpd]')];
    if(scope.matches?.('[data-mvpd]'))roots.unshift(scope);
    roots.forEach(section=>{if(!instances.has(section)){const cleanup=initialize(section);if(cleanup)instances.set(section,cleanup);}});
  }
  document.addEventListener('shopify:section:load',event=>scan(event.target));
  document.addEventListener('shopify:section:unload',event=>{
    for(const [section,cleanup] of instances){if(event.target===section||event.target.contains(section)){cleanup();instances.delete(section);}}
  });
