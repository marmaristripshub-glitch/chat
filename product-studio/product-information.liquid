{% comment %}
  MarketVitrini PRO — Tek Shopify ürünü / 1-2-3 adet / gerçek sepet senkronu
  Standalone Shopify OS 2.0 product-template section.
  Real product variants, real compare-at prices, optional upsell, AJAX cart and checkout.
  Self-contained product-information section with a consolidated Studio design.
  REFERANS EKRAN METINLERI V7 (gorseldeki ornek):
  Eski fiyat: 1.499 TL | Yeni fiyat: 899 TL | %40 INDIRIM | 600 TL Kazancin var!
  Bu tutarlar Shopify'daki gercek fiyatlar ile karismamasi icin sabit yazilmaz,
  secili varyantin price ve compare_at_price alanlarindan hesaplanir.
{% endcomment %}
{% liquid
  assign mv_p = product
  if mv_p == blank
    assign mv_p = closest.product
  endif
  assign mv_v = blank
  if mv_p != blank
    assign mv_v = mv_p.selected_or_first_available_variant
  endif
  assign mv_sale = false
  if mv_v != blank and mv_v.compare_at_price > mv_v.price
    assign mv_sale = true
    assign mv_diff = mv_v.compare_at_price | minus: mv_v.price
  endif
  assign mv_origin = mv_v.price
  if mv_sale
    assign mv_origin = mv_v.compare_at_price
  endif
  assign mv_min = mv_v.quantity_rule.min | default: 1
  assign mv_inc = mv_v.quantity_rule.increment | default: 1
  assign mv_max = mv_v.quantity_rule.max
  assign mv_form_id = 'mvpd-form-' | append: section.id
  assign mv_gallery_manual = false
  if section.settings.use_manual_gallery and section.settings.gallery_image_1 != blank
    assign mv_gallery_manual = true
  endif
%}
<section id="mvpd-{{ section.id }}" class="mvpd" data-mvpd data-mv-section
  data-cart-url="{{ routes.cart_add_url }}.js"
  data-cart-redirect="{{ routes.cart_url }}"
  data-checkout-redirect="{{ routes.root_url }}checkout"
  data-root-url="{{ routes.root_url }}"
  data-next="{{ section.settings.purchase_destination }}"
  style="--mvpd-accent:{{ section.settings.accent }};--mvpd-accent-dark:{{ section.settings.accent_dark }};--mvpd-head:{{ section.settings.heading_color }};--mvpd-muted:{{ section.settings.muted_color }};--mvpd-surface:{{ section.settings.card_color }};--mvpd-soft:{{ section.settings.soft_color }};--mvpd-border:{{ section.settings.border_color }};--mvpd-width:{{ section.settings.max_width }}px;--mvpd-radius:{{ section.settings.card_radius }}px;--mvpd-price:{{ section.settings.price_color }};--mvpd-gallery-badge:{{ section.settings.gallery_badge_color }};--mvpd-gallery-badge-text:{{ section.settings.gallery_badge_text_color }};--mvpd-feature-text:{{ section.settings.feature_text_color }};--mvpd-review-text:{{ section.settings.review_text_color }};--mvpd-social-bg:{{ section.settings.social_bg_color }};--mvpd-social-text:{{ section.settings.social_text_color }};--mvpd-price-badge-bg:{{ section.settings.price_badge_color }};--mvpd-price-badge-text:{{ section.settings.price_badge_text_color }};--mvpd-stock-bg:{{ section.settings.stock_panel_color }};--mvpd-stock-text:{{ section.settings.stock_text_color }};--mvpd-stock-bar-bg:{{ section.settings.stock_bar_track_color }};--mvpd-stock-bar:{{ section.settings.stock_bar_color }};--mvpd-summary-bg:{{ section.settings.summary_bg_color }};--mvpd-total-bg:{{ section.settings.total_panel_bg }};--mvpd-trust-icon:{{ section.settings.trust_icon_color }};--mvpd-trust-icon-bg:{{ section.settings.trust_icon_bg }};--mvpd-satisfaction-bg:{{ section.settings.satisfaction_panel_bg }};--mvpd-satisfaction-text:{{ section.settings.satisfaction_text_color }};--mvpd-upsell-bg:{{ section.settings.upsell_panel_bg }};--mvpd-upsell-btn:{{ section.settings.upsell_btn_color }};--mvpd-upsell-btn-text:{{ section.settings.upsell_btn_text_color }};--mvpd-upsell-badge:{{ section.settings.upsell_badge_color }};--mvpd-payment-bg:{{ section.settings.payment_bg_color }};">
{% if mv_p == blank %}
  <div class="mvpd__empty">Bu bölüm ürün şablonunda kullanılmalıdır. Lütfen bir ürün sayfasında önizleyin.</div>
{% else %}
  <div class="mvpd__topline">
    <nav class="mvpd__breadcrumb" aria-label="İçerik yolu"><a href="{{ routes.root_url }}">Ana sayfa</a><span aria-hidden="true">/</span><span>{{ mv_p.title | escape }}</span></nav>
    {% if section.settings.studio_kicker != blank %}<span class="mvpd__edition"><span aria-hidden="true"></span>{{ section.settings.studio_kicker | escape }}</span>{% endif %}
  </div>
  <div class="mvpd__layout">
    <div class="mvpd__main">
      <div class="mvpd__gallery" aria-label="Ürün görselleri">
        <div class="mvpd__viewer">
          {% if section.settings.show_media_slogan and section.settings.media_slogan != blank %}<span class="mvpd__media-slogan">{{ section.settings.media_slogan | escape }}</span>{% endif %}
          {% if section.settings.show_gallery_badge and section.settings.gallery_badge_text != blank %}<span class="mvpd__sale-flag" data-mvpd-flag>{{ section.settings.gallery_badge_text | escape }}</span>{% endif %}
          {% if mv_gallery_manual %}
            {% for index in (1..6) %}
              {% assign key = 'gallery_image_' | append: index %}
              {% assign gallery_image = section.settings[key] %}
              {% if gallery_image != blank %}
                <div class="mvpd__media-item{% if forloop.first %} is-active{% endif %}" data-mvpd-media="manual-{{ index }}" {% unless forloop.first %}hidden{% endunless %}>
                {% assign image_loading = 'lazy' %}{% assign image_priority = 'auto' %}{% if forloop.first %}{% assign image_loading = 'eager' %}{% assign image_priority = 'high' %}{% endif %}
                {{ gallery_image | image_url: width: 1500 | image_tag: loading: image_loading, fetchpriority: image_priority, widths: '400,600,900,1200,1500', sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1099px) 48vw, 32vw', class: 'mvpd__big-image', alt: gallery_image.alt }}
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
          {% for media in mv_p.media limit: 12 %}
            <div class="mvpd__media-item{% if forloop.first %} is-active{% endif %}" data-mvpd-media="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {% case media.media_type %}
                {% when 'image' %}
                  {% assign image_loading = 'lazy' %}{% assign image_priority = 'auto' %}{% if forloop.first %}{% assign image_loading = 'eager' %}{% assign image_priority = 'high' %}{% endif %}
                  {{ media | image_url: width: 1500 | image_tag: loading: image_loading, fetchpriority: image_priority, widths: '400,600,900,1200,1500', sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1099px) 48vw, 32vw', class: 'mvpd__big-image', alt: media.alt }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, image_size: '1100x', class: 'mvpd__big-video' }}
                {% when 'external_video' %}
                  {{ media | external_video_tag: class: 'mvpd__big-video' }}
                {% else %}
                  {% if media.preview_image != blank %}{{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'mvpd__big-image', alt: media.alt }}{% endif %}
              {% endcase %}
            </div>
          {% else %}
            <div class="mvpd__media-item is-active">{{ 'product-1' | placeholder_svg_tag: 'mvpd__big-image mvpd__placeholder' }}</div>
          {% endfor %}
          {% endif %}
        </div>
        {% if mv_gallery_manual %}
          <div class="mvpd__thumbs" role="group" aria-label="Manuel ürün görseli seçimi">
            {% for index in (1..6) %}
              {% assign key = 'gallery_image_' | append: index %}
              {% assign gallery_image = section.settings[key] %}
              {% if gallery_image != blank %}
                <button class="mvpd__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-mvpd-thumb="manual-{{ index }}" aria-label="{{ index }}. görsel" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                  {{ gallery_image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'mvpd__thumb-img', alt: gallery_image.alt }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
          <button class="mvpd__thumb-more" type="button" data-mvpd-thumb-more aria-label="Diğer ürün görselleri"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></button>
        {% elsif mv_p.media.size > 1 %}
          <div class="mvpd__thumbs" role="group" aria-label="Ürün görseli seçimi">
            {% for media in mv_p.media limit: 12 %}
              <button class="mvpd__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-mvpd-thumb="{{ media.id }}" aria-label="{{ forloop.index }}. görsel" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                {% if media.preview_image != blank %}{{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', class: 'mvpd__thumb-img', alt: media.alt }}{% endif %}
                {% if media.media_type != 'image' %}<span class="mvpd__play" aria-hidden="true">▶</span>{% endif %}
              </button>
            {% endfor %}
          </div>
          <button class="mvpd__thumb-more" type="button" data-mvpd-thumb-more aria-label="Diğer ürün görsellerini göster"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
        {% endif %}
        <div class="mvpd__gallery-footer">
          <span>{{ section.settings.studio_gallery_caption | escape }}</span>
          <div class="mvpd__gallery-navigation"><button type="button" data-mvpd-prev aria-label="Önceki görsel">←</button><span data-mvpd-gallery-count aria-live="polite">1 / {% if mv_gallery_manual %}6{% else %}{{ mv_p.media.size | at_least: 1 }}{% endif %}</span><button type="button" data-mvpd-next aria-label="Sonraki görsel">→</button></div>
        </div>
      </div>

      <div class="mvpd__details">
        {% if section.settings.show_vendor and section.settings.reference_vendor != blank %}
          <div class="mvpd__vendor">{{ section.settings.reference_vendor | escape }}</div>
        {% endif %}
        <h1 class="mvpd__title">{{ mv_p.title | escape }}</h1>
        {% if section.settings.show_subtitle and section.settings.subtitle != blank %}
          <p class="mvpd__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.social_proof_text != blank or section.settings.mv_show_rating_bar and section.settings.verified_rating != blank and section.settings.verified_reviews_count != blank %}
          <div class="mvpd__review mvpd__review--reference" aria-label="Değerlendirmeler ve bilgiler">
            {% if section.settings.mv_show_rating_bar and section.settings.verified_rating != blank and section.settings.verified_reviews_count != blank %}
              <span class="mvpd__review-stars" aria-hidden="true">{{ section.settings.manual_stars | escape }}</span>
              <strong class="mvpd__rating-value">{{ section.settings.verified_rating | escape }}</strong>
              <small class="mvpd__rating-count">({{ section.settings.verified_reviews_count | escape }} {{ section.settings.review_count_label | escape }})</small>
            {% endif %}
            {% if section.settings.social_proof_text != blank %}
              <span class="mvpd__social-proof"><span class="mvpd__social-symbol" aria-hidden="true">{{ section.settings.social_proof_icon | escape }}</span> {{ section.settings.social_proof_text | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
        {% form 'product', mv_p, id: mv_form_id, class: 'mvpd__form' %}
            <div class="mvpd__price-area">
              {% if mv_sale and section.settings.show_compare_price %}<s data-mvpd-old>{{ mv_v.compare_at_price | money_without_trailing_zeros }}</s>{% else %}<s data-mvpd-old hidden></s>{% endif %}
              <div class="mvpd__price-line">
                <strong data-mvpd-unit>{{ mv_v.price | money_without_trailing_zeros }}</strong>
                {% if section.settings.show_price_badge and section.settings.price_badge_text != blank %}<span class="mvpd__pct" data-mvpd-pct>{{ section.settings.price_badge_text | escape }}</span>{% endif %}
                {% if section.settings.show_savings_box %}<span class="mvpd__save" data-mvpd-save><b data-mvpd-save-amount>{% if section.settings.savings_value != blank %}{{ section.settings.savings_value | escape }}{% elsif mv_sale %}{{ mv_diff | money_without_trailing_zeros }}{% endif %}</b><small>{{ section.settings.savings_label | escape }}</small></span>{% endif %}
              </div>
            </div>
        {% if section.settings.show_features %}
          <ul class="mvpd__features mvpd__features--reference" aria-label="Öne çıkan özellikler">
            {% for n in (1..6) %}
              {% assign feature_key = 'feature_' | append: n %}
              {% assign feature_text = section.settings[feature_key] %}
              {% if feature_text != blank %}
                <li><span class="mvpd__feature-check" aria-hidden="true">{{ section.settings.feature_icon | escape }}</span><span>{{ feature_text | escape }}</span></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

          {% unless mv_p.has_only_default_variant %}
            <label class="mvpd__field-label" for="mvpd-variant-{{ section.id }}">{{ section.settings.variant_label | escape }}</label>
            <select class="mvpd__variant" id="mvpd-variant-{{ section.id }}" data-mvpd-variant name="id">
              {% for variant in mv_p.variants %}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}" data-inventory="{{ variant.inventory_quantity }}" data-inventory-management="{{ variant.inventory_management }}" data-inventory-policy="{{ variant.inventory_policy }}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-inc="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" {% if variant.id == mv_v.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title | escape }}{% unless variant.available %}  — {{ section.settings.variant_sold_out_label | escape }}{% endunless %}
                </option>
              {% endfor %}
            </select>
          {% endunless %}
          <input type="hidden" name="id" value="{{ mv_v.id }}" data-mvpd-id{% unless mv_p.has_only_default_variant %} disabled{% endunless %}>
          <div class="mvpd__purchase-row">
            <div class="mvpd__quantity-area">
              <label class="mvpd__field-label" for="mvpd-qty-{{ section.id }}">{{ section.settings.quantity_label | escape }}</label>
              <div class="mvpd__qty">
                <button type="button" data-mvpd-minus aria-label="Adet azalt">−</button>
                <input id="mvpd-qty-{{ section.id }}" type="number" name="quantity" value="{{ mv_min }}" min="{{ mv_min }}" step="{{ mv_inc }}" {% if mv_max != blank %}max="{{ mv_max }}"{% endif %} data-mvpd-qty aria-label="Ürün adedi">
                <button type="button" data-mvpd-plus aria-label="Adet artır">+</button>
              </div>
            </div>
          </div>
          <div class="mvpd__main-action">
            <button type="submit" class="mvpd__add" data-mvpd-add{% unless mv_v.available %} disabled{% endunless %}><span data-mvpd-add-label>{% if mv_v.available %}{{ section.settings.studio_add_label | escape }}{% else %}{{ section.settings.variant_sold_out_label | escape }}{% endif %}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></button>
            <span class="mvpd__action-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>{{ section.settings.studio_secure_note | escape }}</span>
          </div>
          {% if section.settings.show_stock_panel and section.settings.reference_stock_text != blank %}<div class="mvpd__inventory-wrap" data-mvpd-stock-panel data-low-stock="true">
            <div class="mvpd__stock-head">
              <div class="mvpd__stock-copy">
                {% if section.settings.stock_icon != blank %}<span class="mvpd__stock-flame" aria-hidden="true">{{ section.settings.stock_icon | escape }}</span>{% endif %}
                <strong class="mvpd__inventory">{{ section.settings.reference_stock_text | escape }}</strong>
                <span class="mvpd__visitor-inline">{{ section.settings.inventory_info | escape }}</span>
              </div>
            </div>
            {% if section.settings.show_stock_progress %}<div class="mvpd__stock-track" aria-hidden="true"><span class="mvpd__stock-fill" style="width:{{ section.settings.manual_stock_progress }}%"></span></div>{% endif %}
          </div>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <aside class="mvpd__summary" aria-label="Sipariş özeti">
      <div class="mvpd__summary-eyebrow">{{ section.settings.studio_summary_kicker | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></div>
      <h2 class="mvpd__summary-title"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h2l2 11h13l2-8H5"/></svg>{{ section.settings.summary_heading | escape }}</h2>
      <div class="mvpd__live-cart-list" data-mvpd-live-cart-list hidden></div>
      <p class="mvpd__cart-check" data-mvpd-cart-check role="status">Shopify sepeti kontrol ediliyor...</p>
      <div class="mvpd__summary-item" data-mvpd-base-summary>
        {% if mv_p.featured_image != blank %}{{ mv_p.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', class: 'mvpd__summary-photo', alt: mv_p.title }}{% endif %}
        <div class="mvpd__summary-product"><strong>{{ mv_p.title | escape }}</strong><small data-mvpd-selected-title>{% unless mv_p.has_only_default_variant %}{{ mv_v.title | escape }}{% endunless %}</small><button type="button" class="mvpd__bundle-remove" data-mvpd-base-remove aria-label="Tekli ürünü sipariş özetinden kaldır">Tek ürünü kaldır</button></div>
        <div class="mvpd__summary-item-price"><span data-mvpd-count>{{ mv_min }} {{ section.settings.quantity_unit | escape }}</span><strong data-mvpd-sum-unit>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</strong><s data-mvpd-summary-old {% unless mv_sale and section.settings.show_compare_price %}hidden{% endunless %}>{% if mv_sale %}{{ mv_v.compare_at_price | times: mv_min | money_without_trailing_zeros }}{% endif %}</s></div>
      </div>
      <div class="mvpd__summary-item mvpd__summary-selected-bundle" data-mvpd-bundle-summary hidden aria-live="polite">
        <img class="mvpd__summary-photo" data-mvpd-bundle-photo alt="" width="52" height="52" hidden>
        <div class="mvpd__summary-product">
          <strong data-mvpd-bundle-name></strong>
          <small data-mvpd-bundle-detail></small>
          <button type="button" class="mvpd__bundle-remove" data-mvpd-bundle-remove aria-label="Paketi sipariş özetinden çıkar">Paketi kaldır</button>
        </div>
        <div class="mvpd__summary-item-price">
          <span data-mvpd-bundle-count></span>
          <strong data-mvpd-bundle-price></strong>
          <s data-mvpd-bundle-old hidden></s>
        </div>
      </div>
      <div class="mvpd__summary-empty" data-mvpd-summary-empty hidden aria-live="polite">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M7 10h18l2 18H5l2-18Z"/><path d="M11 11V8a5 5 0 0 1 10 0v3"/></svg><strong>Sepetiniz sizi bekliyor.</strong><span>Ürünü veya size uygun paketi seçerek başlayın.</span>
        <button type="button" class="mvpd__summary-restore" data-mvpd-base-restore>1 adet ekle</button>
      </div>
      <div class="mvpd__sums">
        <div><span>{{ section.settings.subtotal_label | escape }}</span><span data-mvpd-subtotal>{{ mv_origin | times: mv_min | money_without_trailing_zeros }}</span></div>
        <div class="mvpd__discount-row" data-mvpd-discount-row><span>{{ section.settings.discount_row_label | escape }}</span><span data-mvpd-discount>{% if mv_sale %}-{{ mv_diff | times: mv_min | money_without_trailing_zeros }}{% else %}0{% endif %}</span></div>
        <div class="mvpd__shipping-row"><span>{{ section.settings.shipping_label | escape }}</span><span data-mvpd-shipping>{{ section.settings.shipping_note | default: '0' | escape }}</span></div>
      </div>
      <div class="mvpd__total-box" aria-live="polite" aria-atomic="true">
        <span>{{ section.settings.total_label | escape }}</span>
        <div class="mvpd__total-value">
          <strong data-mvpd-total>{{ mv_v.price | times: mv_min | money_without_trailing_zeros }}</strong>
          {% if section.settings.mv_show_total_savings %}
            <small class="mvpd__total-savings-badge" data-mvpd-savings>
              <span class="mvpd__savings-symbol" aria-hidden="true">{{ section.settings.mv_total_savings_icon | escape }}</span>
              <span data-mvpd-savings-amount>
                {% if section.settings.mv_manual_total_savings != blank %}
                  {{ section.settings.mv_manual_total_savings | escape }}
                {% elsif mv_sale %}
                  {{ mv_diff | times: mv_min | money_without_trailing_zeros }}
                {% else %}
                  {{ section.settings.mv_total_fallback_text | escape }}
                {% endif %}
              </span>
              <span data-mvpd-savings-label>{% if section.settings.mv_manual_total_savings != blank or mv_sale %}{{ section.settings.savings_label | escape }}{% endif %}</span>
            </small>
          {% endif %}
        </div>
      </div>
      {% if section.settings.show_coupon %}
        <div class="mvpd__coupon"><label for="mvpd-coupon-{{ section.id }}">{{ section.settings.coupon_label | escape }}</label><div class="mvpd__coupon-fields"><input id="mvpd-coupon-{{ section.id }}" type="text" placeholder="{{ section.settings.coupon_placeholder | escape }}" data-mvpd-coupon autocomplete="off"><button type="button" data-mvpd-coupon-apply>{{ section.settings.coupon_button_label | escape }}</button></div><p class="mvpd__coupon-info" data-mvpd-coupon-info hidden>{{ section.settings.coupon_info | escape }}</p></div>
      {% endif %}
      <button type="button" class="mvpd__checkout" data-mvpd-checkout disabled>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <span data-mvpd-checkout-label>{{ section.settings.checkout_label | escape }}</span><span aria-hidden="true">→</span>
      </button>
      <div class="mvpd__error" data-mvpd-error role="alert" hidden></div>
      {% if section.settings.mv_show_payment_area %}
        <div class="mvpd__payments" aria-label="Ödeme yöntemleri">
          {% for index in (1..6) %}
            {% assign payment_image_key = 'payment_image_' | append: index %}
            {% assign payment_image = section.settings[payment_image_key] %}
            {% if payment_image != blank %}
              {{ payment_image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'mvpd__payment-icon', alt: payment_image.alt }}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% if section.settings.mv_show_installments %}
        <div class="mvpd__installments" aria-label="Taksit seçenekleri">
          {% if section.settings.mv_installments_title != blank %}<h3 class="mvpd__installments-title">{{ section.settings.mv_installments_title | escape }}</h3>{% endif %}
          {% if section.settings.mv_installments_subtitle != blank %}<p class="mvpd__installments-subtitle">{{ section.settings.mv_installments_subtitle | escape }}</p>{% endif %}
          <div class="mvpd__installment-logos">
            {% for index in (1..8) %}
              {% assign installment_image_key = 'mv_installment_image_' | append: index %}
              {% assign installment_image = section.settings[installment_image_key] %}
              {% if installment_image != blank %}
                <span class="mvpd__installment-logo">{{ installment_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: installment_image.alt }}</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
      {% if section.settings.show_trust %}
        <div class="mvpd__trusts">
          {% if section.settings.show_trust_1 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 10H4V5"/><path d="M4.5 10a8 8 0 1 1 2.2 7"/><path d="M9 13h6"/></svg>{% else %}{{ section.settings.trust_icon_1 | escape }}{% endif %}</span><strong>{{ section.settings.trust_1 | escape }}</strong><small>{{ section.settings.trust_note_1 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_2 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3 8 8 11 5-3 8-6 8-11V5l-8-3Z"/><path d="m8 12 3 3 5-6"/></svg>{% else %}{{ section.settings.trust_icon_2 | escape }}{% endif %}</span><strong>{{ section.settings.trust_2 | escape }}</strong><small>{{ section.settings.trust_note_2 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_3 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v11H3zM14 11h4l3 4v3h-7"/><circle cx="7.5" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>{% else %}{{ section.settings.trust_icon_3 | escape }}{% endif %}</span><strong>{{ section.settings.trust_3 | escape }}</strong><small>{{ section.settings.trust_note_3 | escape }}</small></div>{% endif %}
          {% if section.settings.show_trust_4 %}<div><span class="mvpd__trust-icon" aria-hidden="true">{% if section.settings.mv_trust_svg_icons %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h5"/></svg>{% else %}{{ section.settings.trust_icon_4 | escape }}{% endif %}</span><strong>{{ section.settings.trust_4 | escape }}</strong><small>{{ section.settings.trust_note_4 | escape }}</small></div>{% endif %}
        </div>
      {% endif %}
      {% if section.settings.show_satisfaction and section.settings.summary_note != blank %}<div class="mvpd__summary-note"><span aria-hidden="true" class="mvpd__medal">{% if section.settings.satisfaction_icon_custom != blank %}<span class="mvpd__medal-custom">{{ section.settings.satisfaction_icon_custom | escape }}</span>{% else %}<svg viewBox="0 0 48 56" fill="none"><path d="M15 35 10 54l14-7 14 7-5-19" fill="#b68a30"/><path d="m24 2 6 4 8 1 1 8 6 6-5 8-1 8-9 2-6 6-7-6-8-2-2-8-5-8 5-7 2-8 8-1 7-4Z" fill="#ad8133"/><circle cx="24" cy="22" r="13" fill="#FDF2D6"/><path d="m24 13 2.5 6 6.5.5-5 4.5 1.5 6-5.5-3.5-5.5 3.5 1.5-6-5-4.5 6.5-.5Z" fill="#AA7B28"/></svg>{% endif %}</span><p>{% if section.settings.summary_note_title != blank %}<strong>{{ section.settings.summary_note_title | default: 'Müşteri Memnuniyeti' | escape }}</strong>{% endif %}{{ section.settings.summary_note | escape }}</p></div>{% endif %}
    </aside>
    <div class="mvpd__bundle-in-slot" data-mvpd-bundle-in-slot>
      <section class="mv-onepack" aria-labelledby="mvpd-packs-title-{{ section.id }}">
        <div class="mv-onepack__heading"><div><span class="mv-onepack__eyebrow">{{ section.settings.studio_package_kicker | escape }}</span><h2 id="mvpd-packs-title-{{ section.id }}">{{ section.settings.studio_package_heading | escape }}</h2></div><p>{{ section.settings.studio_package_text | escape }}</p></div>
        <div class="mv-onepack__grid">
          {% for pack_number in (1..3) %}
            {% liquid
              assign pack_block = blank
              for block in section.blocks
                if block.type == 'bundle' and block.settings.qty == pack_number
                  assign pack_block = block
                  break
                endif
              endfor
              assign pack_image = mv_p.featured_image
              if pack_block != blank and pack_block.settings.image != blank
                assign pack_image = pack_block.settings.image
              endif
              assign pack_accent = section.settings.accent
              assign pack_soft = section.settings.soft_color
              if pack_number == 2
                assign pack_accent = section.settings.accent
                assign pack_soft = section.settings.soft_color
              elsif pack_number == 3
                assign pack_accent = section.settings.accent
                assign pack_soft = section.settings.soft_color
              endif
              if pack_block != blank
                assign pack_accent = pack_block.settings.accent | default: pack_accent
                assign pack_soft = pack_block.settings.soft | default: pack_soft
              endif
              assign pack_total = mv_v.price | times: pack_number
            %}
            <article class="mv-onepack__card{% if pack_number == 2 %} mv-onepack__card--featured{% endif %}" data-mv-pack data-qty="{{ pack_number }}" {{ pack_block.shopify_attributes }} style="--pack-accent:{{ pack_accent }};--pack-soft:{{ pack_soft }}">
              {% if pack_number == 2 %}<div class="mv-onepack__ribbon"><span aria-hidden="true">✦</span> {{ section.settings.mv_b16_featured_badge_fallback | escape }}</div>{% endif %}
              <div class="mv-onepack__visual mv-onepack__visual--{{ pack_number }}" aria-hidden="true">
                {% if pack_image != blank %}
                  {% for image_copy in (1..pack_number) %}
                    {{ pack_image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'mv-onepack__img' }}
                  {% endfor %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'mv-onepack__img mv-onepack__img--placeholder' }}
                {% endif %}
              </div>
              <div class="mv-onepack__qty-label"><span>{{ pack_number }} <small>ADET</small></span><span class="mv-onepack__choice-icon" aria-hidden="true">✓</span></div>
              <p class="mv-onepack__unit-price" data-mv-pack-unit>{{ mv_v.price | money_without_trailing_zeros }} / adet</p><strong class="mv-onepack__price" data-mv-pack-price>{{ pack_total | money_without_trailing_zeros }}</strong>
              <small class="mv-onepack__real-saving" data-mv-pack-saving hidden></small>
              <button class="mv-onepack__button" type="button" data-mv-pack-select aria-pressed="false" {% unless mv_v.available %}disabled{% endunless %}>{{ section.settings.mv_b16_button_text | escape }}</button>
            </article>
          {% endfor %}
        </div>
        {% if section.settings.studio_package_note != blank %}<p class="mv-onepack__note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/></svg>{{ section.settings.studio_package_note | escape }}</p>{% endif %}
      </section>
    </div>
  </div>
  {% for app_block in section.blocks %}{% if app_block.type == '@app' %}<div class="mvpd__apps">{% render app_block %}</div>{% endif %}{% endfor %}
{% endif %}
{% capture studio_config %}{
  "productId":{{ mv_p.id | json }},
  "checkoutLabel":{{ section.settings.checkout_label | json }},
  "loadingLabel":{{ section.settings.loading_button_label | json }},
  "unitText":{{ section.settings.quantity_unit | json }},
  "showCompare":{{ section.settings.show_compare_price | json }},
  "currency":{{ cart.currency.iso_code | default: shop.currency | json }},
  "addLabel":{{ section.settings.studio_add_label | json }},
  "soldLabel":{{ section.settings.variant_sold_out_label | json }},
  "manualSaving":{{ section.settings.savings_value | json }},
  "packLabel":{{ section.settings.mv_b16_button_text | json }},
  "variants":[{% for variant in mv_p.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | default: 0 | json }},"available":{{ variant.available | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"inc":{{ variant.quantity_rule.increment | default: 1 | json }},"max":{% if variant.quantity_rule.max != blank %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %},"mediaId":{{ variant.featured_media.id | default: '' | json }},"title":{{ variant.title | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}{% endcapture %}
<script type="application/json" data-mvpd-config>{{ studio_config | replace: '<', '\u003c' }}</script>
</section>

<style>
/* Product Studio: one scoped design system, no external styles or fonts. */
#mvpd-{{ section.id }}{
  --studio-ink:var(--mvpd-head);--studio-line:var(--mvpd-border);--studio-accent:var(--mvpd-accent);
  background:{{ section.settings.page_background }};color:var(--studio-ink);padding:30px 32px 64px;
  font-family:var(--font-body--family,inherit);font-size:14px;line-height:1.5;isolation:isolate;
  -webkit-font-smoothing:antialiased;
}
#mvpd-{{ section.id }} *,#mvpd-{{ section.id }} *::before,#mvpd-{{ section.id }} *::after{box-sizing:border-box}
#mvpd-{{ section.id }} [hidden]{display:none!important}
#mvpd-{{ section.id }} :is(h1,h2,h3,p){margin:0;overflow-wrap:anywhere}
#mvpd-{{ section.id }} :is(button,input,select){font:inherit;letter-spacing:normal}
#mvpd-{{ section.id }} button{touch-action:manipulation;cursor:pointer}
#mvpd-{{ section.id }} button:disabled{cursor:not-allowed;opacity:.48}
#mvpd-{{ section.id }} :is(button,a,input,select):focus-visible{outline:3px solid var(--studio-accent);outline-offset:4px;box-shadow:0 0 0 6px white}
#mvpd-{{ section.id }} svg{display:block;flex:none;width:20px;height:20px}
#mvpd-{{ section.id }} .mvpd__topline{max-width:var(--mvpd-width);margin:0 auto 27px;display:flex;justify-content:space-between;align-items:center;gap:20px}
#mvpd-{{ section.id }} .mvpd__breadcrumb{display:flex;align-items:center;gap:10px;min-width:0;font-size:11px;color:var(--mvpd-muted)}
#mvpd-{{ section.id }} .mvpd__breadcrumb a{color:inherit;text-decoration:none;white-space:nowrap}
#mvpd-{{ section.id }} .mvpd__breadcrumb>span:last-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:320px}
#mvpd-{{ section.id }} .mvpd__edition{display:flex;gap:8px;align-items:center;font-size:9px;letter-spacing:.16em;font-weight:650;color:var(--mvpd-muted);text-align:right}
#mvpd-{{ section.id }} .mvpd__edition>span{width:6px;height:6px;border-radius:50%;background:var(--studio-accent);flex:none}
#mvpd-{{ section.id }} .mvpd__layout{max-width:var(--mvpd-width);margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 330px;grid-template-areas:"main summary" "packs summary";gap:36px 32px;align-items:start}
#mvpd-{{ section.id }} .mvpd__main{grid-area:main;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;min-width:0;align-items:start}
#mvpd-{{ section.id }} .mvpd__gallery{min-width:0;display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
#mvpd-{{ section.id }} .mvpd__viewer{position:relative;height:clamp(380px,38vw,520px);min-width:0;border:1px solid var(--studio-line);border-radius:var(--mvpd-radius);overflow:hidden;background:{{ section.settings.product_image_bg }}}
#mvpd-{{ section.id }} .mvpd__media-item{position:absolute;inset:0;align-items:center;justify-content:center;display:flex;width:100%;height:100%}
#mvpd-{{ section.id }} .mvpd__media-item :is(img,video,iframe,model-viewer){display:block;width:100%;height:100%;object-fit:{{ section.settings.image_fit }};border:0}
#mvpd-{{ section.id }} .mvpd__media-item>svg{width:80%;height:80%}
#mvpd-{{ section.id }} .mvpd__sale-flag{position:absolute;top:17px;left:17px;z-index:2;border:1px solid rgb(255 255 255 / .65);background:var(--mvpd-gallery-badge);color:var(--mvpd-gallery-badge-text);padding:7px 11px;border-radius:999px;font-size:10px;font-weight:650}
#mvpd-{{ section.id }} .mvpd__media-slogan{position:absolute;z-index:2;right:17px;bottom:17px;max-width:180px;background:rgb(255 255 255 / .9);color:var(--studio-ink);padding:9px 13px;border-radius:10px;font-size:11px;backdrop-filter:blur(8px)}
#mvpd-{{ section.id }} .mvpd__thumbs{display:flex;gap:9px;overflow-x:auto;padding:3px 3px 6px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--studio-line) transparent}
#mvpd-{{ section.id }} .mvpd__thumb{flex:0 0 64px;width:64px;height:70px;border:1px solid var(--studio-line);border-radius:11px;position:relative;background:{{ section.settings.mv_gallery_thumb_bg }};padding:4px;overflow:hidden;scroll-snap-align:start;transition:border-color .2s ease,box-shadow .2s ease}
#mvpd-{{ section.id }} .mvpd__thumb.is-active{border-color:{{ section.settings.mv_selected_thumb_border }};box-shadow:0 0 0 1px {{ section.settings.mv_selected_thumb_border }}}
#mvpd-{{ section.id }} .mvpd__thumb img{display:block;width:100%;height:100%;object-fit:contain;border-radius:6px}
#mvpd-{{ section.id }} .mvpd__thumb-more{display:none}
#mvpd-{{ section.id }} .mvpd__play{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;color:white;background:rgb(0 0 0 / .25)}
#mvpd-{{ section.id }} .mvpd__gallery-footer{display:flex;justify-content:space-between;gap:12px;align-items:center;color:var(--mvpd-muted);font-size:10px;padding-inline:2px}
#mvpd-{{ section.id }} .mvpd__gallery-navigation{display:flex;gap:9px;align-items:center;flex:none;font-size:10px;font-variant-numeric:tabular-nums}
#mvpd-{{ section.id }} .mvpd__gallery-navigation button{display:grid;place-items:center;width:32px;height:32px;background:transparent;color:var(--studio-ink);border:1px solid var(--studio-line);border-radius:50%;font-size:16px}
#mvpd-{{ section.id }} .mvpd__details{min-width:0;padding:5px 0}
#mvpd-{{ section.id }} .mvpd__vendor{margin-bottom:12px;color:var(--studio-accent);font-size:10px;text-transform:uppercase;letter-spacing:.18em;font-weight:700}
#mvpd-{{ section.id }} .mvpd__title{font-family:var(--font-heading--family,inherit);font-size:clamp(27px,2.65vw,40px);font-weight:650;letter-spacing:-.045em;line-height:1.13;text-wrap:balance;margin-bottom:14px}
#mvpd-{{ section.id }} .mvpd__subtitle{color:{{ section.settings.subtitle_text_color }};font-size:13px;line-height:1.7;margin-bottom:17px}
#mvpd-{{ section.id }} .mvpd__review{display:flex;flex-wrap:wrap;gap:7px;align-items:center;font-size:11px;color:var(--mvpd-review-text);margin-bottom:19px}
#mvpd-{{ section.id }} .mvpd__review-stars{color:{{ section.settings.rating_star_color }};letter-spacing:1px;font-size:12px}
#mvpd-{{ section.id }} .mvpd__rating-value{font-size:11px}
#mvpd-{{ section.id }} .mvpd__rating-count{font-size:10px;color:var(--mvpd-muted)}
#mvpd-{{ section.id }} .mvpd__social-proof{display:inline-flex;gap:5px;align-items:center;background:var(--mvpd-social-bg);color:var(--mvpd-social-text);padding:5px 8px;border-radius:6px;font-size:10px}
#mvpd-{{ section.id }} .mvpd__form{display:flex;flex-direction:column;margin:0;gap:0}
#mvpd-{{ section.id }} .mvpd__price-area{margin:0 0 22px;padding-bottom:22px;border-bottom:1px solid var(--studio-line)}
#mvpd-{{ section.id }} .mvpd__price-area>s{color:{{ section.settings.mv_old_price_color }};display:block;font-size:13px;line-height:1.2;margin-bottom:6px}
#mvpd-{{ section.id }} .mvpd__price-line{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
#mvpd-{{ section.id }} [data-mvpd-unit]{font-size:32px;line-height:1.1;font-weight:650;letter-spacing:-.05em;color:var(--mvpd-price);font-variant-numeric:tabular-nums}
#mvpd-{{ section.id }} .mvpd__pct{background:var(--mvpd-price-badge-bg);color:var(--mvpd-price-badge-text);font-size:9px;font-weight:700;padding:5px 7px;border-radius:5px}
#mvpd-{{ section.id }} .mvpd__save{display:flex;gap:4px;align-items:baseline;color:var(--mvpd-muted);font-size:10px;flex-basis:100%;margin-top:2px}
#mvpd-{{ section.id }} .mvpd__save b{color:var(--studio-accent);font-weight:650}
#mvpd-{{ section.id }} .mvpd__save small{font-size:10px}
#mvpd-{{ section.id }} .mvpd__features{list-style:none;display:grid;gap:10px;padding:0;margin:0 0 24px;color:var(--mvpd-feature-text)}
#mvpd-{{ section.id }} .mvpd__features li{display:flex;align-items:flex-start;gap:9px;font-size:12px;line-height:1.55}
#mvpd-{{ section.id }} .mvpd__feature-check{display:grid;place-items:center;width:18px;height:18px;flex:0 0 18px;margin-top:1px;background:{{ section.settings.mv_feature_icon_bg }};color:{{ section.settings.mv_feature_icon_color }};border-radius:50%;font-size:10px;font-weight:700}
#mvpd-{{ section.id }} .mvpd__field-label{display:block;color:{{ section.settings.mv_input_label_color }};font-size:11px;font-weight:650;margin-bottom:8px}
#mvpd-{{ section.id }} .mvpd__variant{display:block;width:100%;min-height:46px;max-width:100%;padding:11px 35px 11px 13px;color:var(--studio-ink);background:var(--mvpd-surface);border:1px solid var(--studio-line);border-radius:10px;cursor:pointer;font-size:12px;margin-bottom:17px}
#mvpd-{{ section.id }} .mvpd__purchase-row{display:flex;gap:15px;align-items:flex-end;margin-bottom:16px}
#mvpd-{{ section.id }} .mvpd__quantity-area{min-width:0}
#mvpd-{{ section.id }} .mvpd__qty{display:inline-flex;align-items:center;border:1px solid {{ section.settings.mv_qty_border_color }};border-radius:10px;background:{{ section.settings.quantity_bg }};overflow:hidden}
#mvpd-{{ section.id }} .mvpd__qty button{border:0;background:{{ section.settings.mv_qty_button_bg }};color:{{ section.settings.mv_qty_button_text }};height:44px;width:40px;font-size:19px;display:grid;place-items:center}
#mvpd-{{ section.id }} .mvpd__qty input{width:42px;height:44px;padding:0;border:0;appearance:textfield;background:transparent;color:{{ section.settings.quantity_text }};text-align:center;font-size:13px;font-weight:650;min-width:0}
#mvpd-{{ section.id }} .mvpd__qty input::-webkit-inner-spin-button,#mvpd-{{ section.id }} .mvpd__qty input::-webkit-outer-spin-button{appearance:none;margin:0}
#mvpd-{{ section.id }} .mvpd__main-action{display:grid;gap:10px;margin-bottom:18px}
#mvpd-{{ section.id }} .mvpd__add{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:50px;padding:13px 18px;color:{{ section.settings.mv_checkout_text_color }};background:var(--studio-accent);border:1px solid var(--studio-accent);border-radius:11px;font-size:13px;font-weight:650;transition:background .2s ease,box-shadow .2s ease}
#mvpd-{{ section.id }} .mvpd__add>svg{width:19px;height:19px}
#mvpd-{{ section.id }} .mvpd__action-note{display:flex;gap:6px;justify-content:center;align-items:center;color:var(--mvpd-muted);font-size:9px}
#mvpd-{{ section.id }} .mvpd__action-note svg{width:12px;height:12px}
#mvpd-{{ section.id }} .mvpd__inventory-wrap{background:var(--mvpd-stock-bg);color:var(--mvpd-stock-text);padding:12px 13px;border-radius:10px;font-size:11px}
#mvpd-{{ section.id }} .mvpd__stock-copy{display:flex;flex-wrap:wrap;align-items:center;gap:5px}
#mvpd-{{ section.id }} .mvpd__visitor-inline{font-size:10px;flex-basis:100%}
#mvpd-{{ section.id }} .mvpd__stock-track{height:3px;margin-top:9px;border-radius:5px;overflow:hidden;background:var(--mvpd-stock-bar-bg)}
#mvpd-{{ section.id }} .mvpd__stock-fill{display:block;height:100%;background:var(--mvpd-stock-bar)}
#mvpd-{{ section.id }} .mvpd__summary{grid-area:summary;position:sticky;top:calc(var(--header-height,0px) + 24px);min-width:0;background:var(--mvpd-summary-bg);border:1px solid var(--studio-line);border-radius:var(--mvpd-radius);padding:25px 23px;box-shadow:0 12px 36px rgb(27 49 34 / .035)}
#mvpd-{{ section.id }} .mvpd__summary-eyebrow{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:.17em;color:var(--mvpd-muted);margin-bottom:8px;font-weight:600}
#mvpd-{{ section.id }} .mvpd__summary-eyebrow>svg{width:15px;height:15px}
#mvpd-{{ section.id }} .mvpd__summary-title{font-size:22px;letter-spacing:-.035em;line-height:1.2;font-weight:650;color:{{ section.settings.mv_summary_heading_color }};display:flex;align-items:center;gap:9px;margin-bottom:22px}
#mvpd-{{ section.id }} .mvpd__summary-title svg{display:none}
#mvpd-{{ section.id }} .mvpd__cart-check{font-size:11px;color:var(--mvpd-muted);padding:12px 0;line-height:1.5}
#mvpd-{{ section.id }} .mvpd__summary-item{display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:start;gap:10px;padding:15px 0;border-bottom:1px solid var(--studio-line);min-width:0}
#mvpd-{{ section.id }} .mvpd__summary-photo{width:48px;height:58px;object-fit:contain;display:block;background:var(--mvpd-soft);border-radius:8px}
#mvpd-{{ section.id }} .mvpd__summary-product{min-width:0}
#mvpd-{{ section.id }} .mvpd__summary-product strong{display:block;font-size:11px;line-height:1.5;font-weight:650;overflow-wrap:anywhere}
#mvpd-{{ section.id }} .mvpd__summary-product small{display:block;font-size:10px;color:var(--mvpd-muted);margin-top:3px}
#mvpd-{{ section.id }} .mvpd__bundle-remove{padding:5px 0;min-height:30px;border:0;background:transparent;text-align:left;font-size:9px;color:var(--mvpd-muted);text-decoration:underline;text-underline-offset:3px}
